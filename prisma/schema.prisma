  branch               Branch                     @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  project              ConstructionProject        @relation(fields: [constructionProjectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
