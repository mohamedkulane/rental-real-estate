model DefectIssue {
  id                    String          @id @db.Uuid
  companyId             String          @db.Uuid
  branchId              String          @db.Uuid
  defectNumber          String          @db.VarChar(50)
  propertyId            String          @db.Uuid
  rentableSpaceId       String?         @db.Uuid
  inspectionId          String?         @db.Uuid
  inspectionItemId      String?         @db.Uuid
  maintenanceRequestId  String?         @db.Uuid
  title                 String          @db.VarChar(200)
  description           String?         @db.Text
  severity              String          @db.VarChar(30)
  status                DefectStatus    @default(OPEN)
  createdAt             DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @db.Timestamptz(6)
  company               Company         @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  branch                Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  property              Property        @relation(fields: [propertyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  rentableSpace         RentableSpace?  @relation(fields: [rentableSpaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  inspection            Inspection?     @relation(fields: [inspectionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  inspectionItem        InspectionItem? @relation(fields: [inspectionItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  maintenanceRequest    MaintenanceRequest? @relation("MaintenanceDefects", fields: [maintenanceRequestId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  followUpRequests      MaintenanceRequest[] @relation("DefectMaintenanceRequests")

  @@unique([companyId, defectNumber], map: "uq_defect_issue_company_number")
  @@index([companyId, branchId, status, createdAt], map: "defect_issue_register_idx")
  @@map("defect_issues")
}

