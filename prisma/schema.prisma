// Phase 1 schema promoted for Phase 2 validation; no migrations have been created or applied.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PartyKind {
  PERSON
  ORGANIZATION
}

enum OwnerStatus {
  PROSPECTIVE
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum PropertyType {
  HOUSE
  VILLA
  APARTMENT_BUILDING
  COMMERCIAL_BUILDING
  COMPOUND
  WAREHOUSE_PROPERTY
  LAND
  MIXED_USE
  OTHER
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  INACTIVE
  RETIRED
}

enum BuildingStatus {
  ACTIVE
  INACTIVE
  RETIRED
}

enum RentableSpaceStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum AreaUnit {
  SQM
  SQFT
  HECTARE
  ACRE
}

enum BranchAccessMode {
  BRANCH
  MULTI_BRANCH
  COMPANY_WIDE
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ServiceModel {
  BROKERAGE
  TENANT_PLACEMENT
  FULL_MANAGEMENT
  MASTER_LEASE_SUBLEASE
  RENT_COLLECTION_ONLY
  COMPANY_OWNED
}

enum EngagementStatus {
  DRAFT
  REVIEW
  APPROVED
  ACTIVE
  SUSPENDED
  TERMINATING
  ENDED
  REJECTED
  CANCELLED
}

enum LeaseKind {
  STANDARD
  SUBLEASE
  COMPANY_OWNED
  COLLECTION_ONLY
}

enum LeaseStatus {
  DRAFT
  REVIEW
  APPROVED
  SIGNING
  SIGNED
  PENDING_POSSESSION
  ACTIVE
  NOTICE
  HOLDOVER
  ENDED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  ACTIVE
  CONVERTED
  EXPIRED
  CANCELLED
  RELEASED
}

enum PaymentStatus {
  CAPTURED
  VERIFYING
  VERIFIED
  POSTED
  PARTIALLY_ALLOCATED
  FULLY_ALLOCATED
  REJECTED
  REVERSED
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum PeriodStatus {
  OPEN
  SOFT_CLOSED
  CLOSED
  LOCKED
}

enum FundClass {
  COMPANY_FUNDS
  OWNER_FUNDS
  SECURITY_DEPOSIT_FUNDS
  TENANT_CREDIT_FUNDS
}

enum DepositTxnType {
  RECEIPT
  ADJUSTMENT
  DEDUCTION
  TRANSFER
  REFUND
  REVERSAL
}

enum ApprovalStatus {
  REQUESTED
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum PayoutStatus {
  DRAFT
  REVIEW
  APPROVED
  QUEUED
  PROCESSING
  PAID
  RECONCILED
  HELD
  REJECTED
  FAILED
  CANCELLED
}

enum UtilityAllocationMethod {
  EQUAL
  AREA_BASED
  METERED
  OCCUPANCY_BASED
  FIXED_AMOUNT
  CUSTOM_PERCENTAGE
}

model Company {
  id              String     @id @db.Uuid
  singletonKey    Boolean    @unique @default(true)
  code            String     @unique @db.VarChar(32)
  name            String     @db.VarChar(200)
  legalName       String?    @db.VarChar(240)
  displayName     String?    @db.VarChar(200)
  phone           String?    @db.VarChar(40)
  email           String?    @db.VarChar(320)
  address         Json?
  logoMetadata    Json?
  defaultCurrency String     @db.Char(3)
  timezone        String     @db.VarChar(64)
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(6)
  branches        Branch[]
  parties         Party[]
  properties      Property[]
  documents       Document[]

  @@map("companies")
}

model Branch {
  id                  String                     @id @db.Uuid
  companyId           String                     @db.Uuid
  code                String                     @db.VarChar(32)
  name                String                     @db.VarChar(160)
  address             Json?
  phone               String?                    @db.VarChar(40)
  email               String?                    @db.VarChar(320)
  active              Boolean                    @default(true)
  createdAt           DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                   @updatedAt @db.Timestamptz(6)
  company             Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employeeAssignments EmployeeBranchAssignment[]
  partyAssignments    PartyBranchAssignment[]
  propertyAssignments PropertyBranchAssignment[]

  @@unique([companyId, code], map: "uq_branches__company_code")
  @@map("branches")
}

model Department {
  id        String  @id @db.Uuid
  companyId String  @db.Uuid
  code      String  @db.VarChar(32)
  name      String  @db.VarChar(120)
  active    Boolean @default(true)

  @@unique([companyId, code])
  @@map("departments")
}

model User {
  id                String               @id @db.Uuid
  emailNormalized   String               @unique @db.VarChar(320)
  passwordHash      String?              @db.VarChar(255)
  status            UserStatus           @default(PENDING)
  passwordChangedAt DateTime?            @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(6)
  employee          Employee?
  sessions          Session[]
  passwordResets    PasswordResetToken[]

  @@map("users")
}

model Session {
  id               String    @id @db.Uuid
  userId           String    @db.Uuid
  tokenHash        String    @unique @db.Char(64)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt        DateTime  @db.Timestamptz(6)
  lastActivityAt   DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  revocationReason String?   @db.VarChar(255)
  ipAddress        String?   @db.VarChar(64)
  userAgent        String?   @db.VarChar(512)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Employee {
  id                String                     @id @db.Uuid
  companyId         String                     @db.Uuid
  userId            String?                    @unique @db.Uuid
  partyId           String                     @unique @db.Uuid
  employeeNumber    String                     @db.VarChar(40)
  accessMode        BranchAccessMode
  jobTitle          String?                    @db.VarChar(120)
  hireDate          DateTime?                  @db.Date
  active            Boolean                    @default(true)
  createdAt         DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                   @updatedAt @db.Timestamptz(6)
  user              User?                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  party             Party                      @relation(fields: [partyId], references: [id], onDelete: Restrict)
  branchAssignments EmployeeBranchAssignment[]
  roles             EmployeeRole[]

  @@unique([companyId, employeeNumber])
  @@map("employees")
}

model EmployeeBranchAssignment {
  id            String    @id @db.Uuid
  employeeId    String    @db.Uuid
  branchId      String    @db.Uuid
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  branch        Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([employeeId, branchId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
  @@map("employee_branch_assignments")
}

model Role {
  id          String           @id @db.Uuid
  companyId   String           @db.Uuid
  code        String           @db.VarChar(64)
  name        String           @db.VarChar(120)
  active      Boolean          @default(true)
  permissions RolePermission[]
  employees   EmployeeRole[]

  @@unique([companyId, code])
  @@map("roles")
}

model Permission {
  id          String           @id @db.Uuid
  code        String           @unique @db.VarChar(100)
  description String           @db.VarChar(255)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model EmployeeRole {
  id            String    @id @db.Uuid
  employeeId    String    @db.Uuid
  roleId        String    @db.Uuid
  branchId      String?   @db.Uuid
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  role          Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([employeeId, roleId, branchId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
  @@map("employee_roles")
}

model Party {
  id                 String                  @id @db.Uuid
  companyId          String                  @db.Uuid
  partyNumber        String                  @db.VarChar(40)
  kind               PartyKind
  displayName        String                  @db.VarChar(240)
  active             Boolean                 @default(true)
  createdAt          DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(6)
  company            Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  person             PersonProfile?
  organization       OrganizationProfile?
  owner              OwnerProfile?
  employee           Employee?
  tenant             TenantProfile?
  applicant          ApplicantProfile?
  vendor             VendorProfile?
  guarantor          GuarantorProfile?
  contacts           ContactPoint[]
  addresses          Address[]
  branchAssignments  PartyBranchAssignment[]
  propertyOwnerships PropertyOwnership[]

  @@unique([companyId, partyNumber])
  @@index([companyId, displayName])
  @@map("parties")
}

model PartyBranchAssignment {
  id            String    @id @db.Uuid
  partyId       String    @db.Uuid
  branchId      String    @db.Uuid
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  party         Party     @relation(fields: [partyId], references: [id], onDelete: Restrict)
  branch        Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([partyId, branchId, effectiveFrom])
  @@index([partyId, effectiveFrom])
  @@index([branchId, effectiveFrom])
  @@map("party_branch_assignments")
}

model PersonProfile {
  partyId                String    @id @db.Uuid
  givenName              String    @db.VarChar(120)
  familyName             String    @db.VarChar(120)
  preferredName          String?   @db.VarChar(120)
  birthDate              DateTime? @db.Date
  nationalityCode        String?   @db.Char(2)
  identificationMetadata Json?
  party                  Party     @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@map("person_profiles")
}

model OrganizationProfile {
  partyId            String  @id @db.Uuid
  legalName          String  @db.VarChar(240)
  tradingName        String? @db.VarChar(240)
  registrationNumber String? @db.VarChar(100)
  contactPersonName  String? @db.VarChar(200)
  party              Party   @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@map("organization_profiles")
}

model OwnerProfile {
  partyId                 String      @id @db.Uuid
  ownerNumber             String      @unique @db.VarChar(40)
  status                  OwnerStatus @default(PROSPECTIVE)
  communicationPreference String?     @db.VarChar(30)
  notes                   String?     @db.Text
  verifiedAt              DateTime?   @db.Timestamptz(6)
  createdAt               DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime    @updatedAt @db.Timestamptz(6)
  party                   Party       @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@map("owner_profiles")
}

model TenantProfile {
  partyId String @id @db.Uuid
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@map("tenant_profiles")
}

model ApplicantProfile {
  partyId String @id @db.Uuid
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@map("applicant_profiles")
}

model VendorProfile {
  partyId    String    @id @db.Uuid
  vendorCode String    @unique @db.VarChar(40)
  approvedAt DateTime? @db.Timestamptz(6)
  party      Party     @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@map("vendor_profiles")
}

model GuarantorProfile {
  partyId String @id @db.Uuid
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@map("guarantor_profiles")
}

model ContactPoint {
  id             String  @id @db.Uuid
  partyId        String  @db.Uuid
  type           String  @db.VarChar(30)
  valueEncrypted String  @db.Text
  normalizedHash String? @db.VarChar(128)
  primary        Boolean @default(false)
  party          Party   @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@index([normalizedHash])
  @@map("contact_points")
}

model Address {
  id          String  @id @db.Uuid
  partyId     String  @db.Uuid
  type        String  @db.VarChar(30)
  line1       String  @db.VarChar(200)
  city        String? @db.VarChar(100)
  countryCode String  @db.Char(2)
  party       Party   @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@map("addresses")
}

model PartyRelationship {
  id            String    @id @db.Uuid
  sourcePartyId String    @db.Uuid
  targetPartyId String    @db.Uuid
  type          String    @db.VarChar(50)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  @@index([sourcePartyId, type])
  @@map("party_relationships")
}

model Property {
  id                String                     @id @db.Uuid
  companyId         String                     @db.Uuid
  propertyCode      String                     @db.VarChar(40)
  name              String                     @db.VarChar(200)
  propertyType      PropertyType
  status            PropertyStatus             @default(DRAFT)
  description       String?                    @db.Text
  addressLine1      String?                    @db.VarChar(200)
  city              String                     @db.VarChar(100)
  district          String?                    @db.VarChar(100)
  neighborhood      String?                    @db.VarChar(100)
  landmark          String?                    @db.VarChar(200)
  latitude          Decimal?                   @db.Decimal(9, 6)
  longitude         Decimal?                   @db.Decimal(9, 6)
  plotArea          Decimal?                   @db.Decimal(20, 6)
  plotAreaUnit      AreaUnit?
  createdAt         DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                   @updatedAt @db.Timestamptz(6)
  company           Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  buildings         Building[]
  spaces            RentableSpace[]
  ownerships        PropertyOwnership[]
  branchAssignments PropertyBranchAssignment[]
  amenities         PropertyAmenity[]
  engagements       ServiceEngagement[]

  @@unique([companyId, propertyCode])
  @@index([companyId, status, propertyType])
  @@map("properties")
}

model Building {
  id             String          @id @db.Uuid
  propertyId     String          @db.Uuid
  buildingCode   String          @db.VarChar(40)
  name           String          @db.VarChar(160)
  numberOfFloors Int?
  attributes     Json?
  status         BuildingStatus  @default(ACTIVE)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  spaces         RentableSpace[]

  @@unique([propertyId, buildingCode])
  @@map("buildings")
}

model PropertyBranchAssignment {
  id            String    @id @db.Uuid
  propertyId    String    @db.Uuid
  branchId      String    @db.Uuid
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  property      Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  branch        Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([propertyId, effectiveFrom])
  @@index([propertyId, effectiveFrom])
  @@index([branchId, effectiveFrom])
  @@map("property_branch_assignments")
}

model PropertyOwnership {
  id               String                     @id @db.Uuid
  propertyId       String                     @db.Uuid
  ownerPartyId     String                     @db.Uuid
  ownershipPercent Decimal                    @db.Decimal(9, 6)
  effectiveFrom    DateTime                   @db.Date
  effectiveTo      DateTime?                  @db.Date
  property         Property                   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  owner            Party                      @relation(fields: [ownerPartyId], references: [id], onDelete: Restrict)
  entitlements     PropertyOwnerEntitlement[]

  @@unique([propertyId, ownerPartyId, effectiveFrom])
  @@index([propertyId, effectiveFrom])
  @@map("property_ownerships")
}

model PropertyOwnerEntitlement {
  id            String            @id @db.Uuid
  ownershipId   String            @db.Uuid
  payoutPercent Decimal           @db.Decimal(9, 6)
  effectiveFrom DateTime          @db.Date
  effectiveTo   DateTime?         @db.Date
  ownership     PropertyOwnership @relation(fields: [ownershipId], references: [id], onDelete: Restrict)

  @@unique([ownershipId, effectiveFrom])
  @@index([ownershipId, effectiveFrom])
  @@map("property_owner_entitlements")
}

model RentableSpaceType {
  id     String          @id @db.Uuid
  code   String          @unique @db.VarChar(50)
  name   String          @db.VarChar(100)
  active Boolean         @default(true)
  spaces RentableSpace[]

  @@map("rentable_space_types")
}

model RentableSpace {
  id                 String                       @id @db.Uuid
  propertyId         String                       @db.Uuid
  buildingId         String?                      @db.Uuid
  typeId             String                       @db.Uuid
  spaceCode          String                       @db.VarChar(50)
  name               String                       @db.VarChar(160)
  status             RentableSpaceStatus          @default(DRAFT)
  createdAt          DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                     @updatedAt @db.Timestamptz(6)
  property           Property                     @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  building           Building?                    @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  type               RentableSpaceType            @relation(fields: [typeId], references: [id], onDelete: Restrict)
  versions           RentableSpaceVersion[]
  childRelations     RentableSpaceParentHistory[] @relation("ChildSpace")
  parentRelations    RentableSpaceParentHistory[] @relation("ParentSpace")
  landProfile        LandSpaceProfile?
  residentialProfile ResidentialSpaceProfile?
  commercialProfile  CommercialSpaceProfile?
  amenities          SpaceAmenity[]

  @@unique([propertyId, spaceCode])
  @@index([propertyId, status, typeId])
  @@map("rentable_spaces")
}

model RentableSpaceVersion {
  id              String        @id @db.Uuid
  rentableSpaceId String        @db.Uuid
  versionNo       Int
  effectiveFrom   DateTime      @db.Date
  effectiveTo     DateTime?     @db.Date
  label           String?       @db.VarChar(160)
  usableArea      Decimal?      @db.Decimal(20, 6)
  totalArea       Decimal?      @db.Decimal(20, 6)
  areaUnit        AreaUnit?
  floorNumber     Int?
  capacity        Int?
  attributes      Json?
  space           RentableSpace @relation(fields: [rentableSpaceId], references: [id], onDelete: Restrict)

  @@unique([rentableSpaceId, versionNo])
  @@unique([rentableSpaceId, effectiveFrom])
  @@index([rentableSpaceId, effectiveFrom])
  @@map("rentable_space_versions")
}

model RentableSpaceParentHistory {
  id            String        @id @db.Uuid
  childSpaceId  String        @db.Uuid
  parentSpaceId String        @db.Uuid
  effectiveFrom DateTime      @db.Date
  effectiveTo   DateTime?     @db.Date
  child         RentableSpace @relation("ChildSpace", fields: [childSpaceId], references: [id], onDelete: Restrict)
  parent        RentableSpace @relation("ParentSpace", fields: [parentSpaceId], references: [id], onDelete: Restrict)

  @@unique([childSpaceId, effectiveFrom])
  @@index([childSpaceId, effectiveFrom])
  @@index([parentSpaceId, effectiveFrom])
  @@map("rentable_space_parent_history")
}

model SpaceSuccessor {
  predecessorSpaceId String   @db.Uuid
  successorSpaceId   String   @db.Uuid
  relationType       String   @db.VarChar(20)
  effectiveDate      DateTime @db.Date

  @@id([predecessorSpaceId, successorSpaceId])
  @@map("space_successors")
}

model LandSpaceProfile {
  rentableSpaceId     String        @id @db.Uuid
  dimensions          String?       @db.VarChar(160)
  permittedUse        String        @db.VarChar(200)
  currentUse          String?       @db.VarChar(200)
  boundaryDescription String?       @db.Text
  roadAccess          String?       @db.VarChar(200)
  fenced              Boolean?
  space               RentableSpace @relation(fields: [rentableSpaceId], references: [id], onDelete: Restrict)

  @@map("land_space_profiles")
}

model ResidentialSpaceProfile {
  rentableSpaceId String        @id @db.Uuid
  bedrooms        Int?
  bathrooms       Decimal?      @db.Decimal(4, 1)
  kitchens        Int?
  livingRooms     Int?
  balconies       Int?
  furnishedStatus String?       @db.VarChar(30)
  space           RentableSpace @relation(fields: [rentableSpaceId], references: [id], onDelete: Restrict)

  @@map("residential_space_profiles")
}

model CommercialSpaceProfile {
  rentableSpaceId String        @id @db.Uuid
  frontageMeters  Decimal?      @db.Decimal(12, 4)
  classification  String?       @db.VarChar(60)
  space           RentableSpace @relation(fields: [rentableSpaceId], references: [id], onDelete: Restrict)

  @@map("commercial_space_profiles")
}

model Amenity {
  id                  String            @id @db.Uuid
  code                String            @unique @db.VarChar(50)
  name                String            @db.VarChar(100)
  active              Boolean           @default(true)
  propertyAssignments PropertyAmenity[]
  spaceAssignments    SpaceAmenity[]

  @@map("amenities")
}

model PropertyAmenity {
  propertyId String   @db.Uuid
  amenityId  String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  @@id([propertyId, amenityId])
  @@map("property_amenities")
}

model SpaceAmenity {
  rentableSpaceId String        @db.Uuid
  amenityId       String        @db.Uuid
  space           RentableSpace @relation(fields: [rentableSpaceId], references: [id], onDelete: Restrict)
  amenity         Amenity       @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  @@id([rentableSpaceId, amenityId])
  @@map("space_amenities")
}

model ServiceEngagement {
  id                         String              @id @db.Uuid
  propertyId                 String              @db.Uuid
  rentableSpaceId            String?             @db.Uuid
  inheritedFromId            String?             @db.Uuid
  model                      ServiceModel
  status                     EngagementStatus
  effectiveFrom              DateTime            @db.Date
  effectiveTo                DateTime?           @db.Date
  overrideMode               String?             @db.VarChar(30)
  agreementDocumentVersionId String?             @db.Uuid
  property                   Property            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  parent                     ServiceEngagement?  @relation("EngagementInheritance", fields: [inheritedFromId], references: [id], onDelete: Restrict)
  children                   ServiceEngagement[] @relation("EngagementInheritance")

  @@index([propertyId, status, effectiveFrom])
  @@index([rentableSpaceId, status, effectiveFrom])
  @@map("service_engagements")
}

model ServiceEngagementParty {
  engagementId String @db.Uuid
  partyId      String @db.Uuid
  role         String @db.VarChar(40)

  @@id([engagementId, partyId, role])
  @@map("service_engagement_parties")
}

model Lead {
  id                 String   @id @db.Uuid
  companyId          String   @db.Uuid
  leadNumber         String   @db.VarChar(40)
  partyId            String?  @db.Uuid
  sourceCode         String   @db.VarChar(50)
  status             String   @db.VarChar(30)
  assignedEmployeeId String?  @db.Uuid
