  actualPercent         Decimal             @db.Decimal(5, 2)
  notes                 String?             @db.VarChar(1000)
  recordedAt            DateTime            @default(now()) @db.Timestamptz(6)
  project               ConstructionProject @relation(fields: [constructionProjectId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([constructionProjectId, recordedAt(sort: Desc)], map: "construction_progress_project_idx")
  @@map("construction_progress_entries")
}

model ConstructionCost {
  id                    String                     @id @db.Uuid
  companyId             String                     @db.Uuid
  constructionProjectId String                     @db.Uuid
  milestoneId           String?                    @db.Uuid
  workPackageId         String?                    @db.Uuid
  expenseId             String                     @unique @db.Uuid
  vendorPartyId         String?                    @db.Uuid
  category              ConstructionBudgetCategory
  amount                Decimal                    @db.Decimal(20, 4)
  currency              String                     @db.Char(3)
  businessDate          DateTime                   @db.Date
  idempotencyKey        String                     @unique @db.VarChar(180)
  createdAt             DateTime                   @default(now()) @db.Timestamptz(6)
  project               ConstructionProject        @relation(fields: [constructionProjectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  milestone             ConstructionMilestone?     @relation(fields: [milestoneId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  workPackage           ConstructionWorkPackage?   @relation(fields: [workPackageId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  expense               Expense                    @relation(fields: [expenseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  vendor                Party?                     @relation("ConstructionCostVendor", fields: [vendorPartyId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([constructionProjectId, businessDate], map: "construction_cost_project_date_idx")
  @@map("construction_costs")
}

model ConstructionBillingEvent {
  id                    String                     @id @db.Uuid
  companyId             String                     @db.Uuid
  constructionProjectId String                     @db.Uuid
  contractId            String                     @db.Uuid
  milestoneId           String?                    @db.Uuid
  installmentSequence   Int?
  basis                 ConstructionBillingBasis
  status                ConstructionBillingStatus  @default(DRAFT)
  amount                Decimal                    @db.Decimal(20, 4)
  currency              String                     @db.Char(3)
  dueDate               DateTime                   @db.Date
  chargeId              String?                    @unique @db.Uuid
  invoiceId             String?                    @db.Uuid
  idempotencyKey        String                     @unique @db.VarChar(180)
  createdAt             DateTime                   @default(now()) @db.Timestamptz(6)
  project               ConstructionProject        @relation(fields: [constructionProjectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  contract              ConstructionContract       @relation(fields: [contractId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  milestone             ConstructionMilestone?     @relation(fields: [milestoneId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  charge                Charge?                    @relation(fields: [chargeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  invoice               Invoice?                   @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([constructionProjectId, status], map: "construction_billing_project_idx")
  @@map("construction_billing_events")
}

model DevelopmentProject {
  id                       String                   @id @db.Uuid
  companyId                String                   @db.Uuid
  branchId                 String                   @db.Uuid
  projectNumber            String                   @db.VarChar(50)
  name                     String                   @db.VarChar(200)
  sourcePropertyId         String                   @db.Uuid
  projectManagerEmployeeId String?                  @db.Uuid
  status                   DevelopmentProjectStatus @default(PLANNING)
  developmentType          DevelopmentType
  plannedStart             DateTime?                @db.Date
  plannedCompletion        DateTime?                @db.Date
  actualCompletion         DateTime?                @db.Date
  totalArea                Decimal?                 @db.Decimal(20, 6)
  areaUnit                 String?                  @db.VarChar(20)
  budgetAmount             Decimal?                 @db.Decimal(20, 4)
  currency                 String                   @db.Char(3)
  notes                    String?                  @db.VarChar(2000)
  createdAt                DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                 @updatedAt @db.Timestamptz(6)
  company                  Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  branch                   Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sourceProperty           Property                 @relation("DevelopmentSourceProperty", fields: [sourcePropertyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  projectManager           Employee?                @relation("DevelopmentProjectManager", fields: [projectManagerEmployeeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  constructionProject      ConstructionProject?
  blocks                   DevelopmentBlock[]
  plots                    DevelopmentPlot[]
  budgetLines              DevelopmentBudgetLine[]
  costs                    DevelopmentCost[]
  outputAssets             DevelopmentOutputAsset[]

  @@unique([companyId, projectNumber], map: "uq_development_project_company_number")
  @@index([companyId, branchId, status], map: "development_project_register_idx")
  @@map("development_projects")
}

model DevelopmentBlock {
  id                   String                 @id @db.Uuid
  developmentProjectId String                 @db.Uuid
  code                 String                 @db.VarChar(40)
  name                 String                 @db.VarChar(160)
  area                 Decimal?               @db.Decimal(20, 6)
  purpose              String?                @db.VarChar(200)
  status               DevelopmentBlockStatus @default(PLANNED)
  notes                String?                @db.VarChar(1000)
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(6)
  project              DevelopmentProject     @relation(fields: [developmentProjectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  plots                DevelopmentPlot[]

  @@unique([developmentProjectId, code], map: "uq_development_block_project_code")
  @@map("development_blocks")
}

model DevelopmentPlot {
  id                   String                 @id @db.Uuid
  developmentProjectId String                 @db.Uuid
  blockId              String?                @db.Uuid
  plotNumber           String                 @db.VarChar(40)
  plannedArea          Decimal?               @db.Decimal(20, 6)
  useType              String?                @db.VarChar(80)
  status               DevelopmentPlotStatus  @default(PLANNED)
  notes                String?                @db.VarChar(1000)
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(6)
  project              DevelopmentProject     @relation(fields: [developmentProjectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  block                DevelopmentBlock?      @relation(fields: [blockId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  outputAsset          DevelopmentOutputAsset?

  @@unique([developmentProjectId, plotNumber], map: "uq_development_plot_project_number")
  @@index([developmentProjectId, status], map: "development_plot_project_status_idx")
  @@map("development_plots")
}

model DevelopmentBudgetLine {
  id                   String                   @id @db.Uuid
  developmentProjectId String                   @db.Uuid
  category             DevelopmentCostCategory
  label                String                   @db.VarChar(160)
  budgetAmount         Decimal                  @db.Decimal(20, 4)
  actualAmount         Decimal                  @default(0) @db.Decimal(20, 4)
  notes                String?                  @db.VarChar(500)
  createdAt            DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                 @updatedAt @db.Timestamptz(6)
  project              DevelopmentProject       @relation(fields: [developmentProjectId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([developmentProjectId, category], map: "development_budget_project_idx")
  @@map("development_budget_lines")
}

model DevelopmentCost {
  id                   String                  @id @db.Uuid
  companyId            String                  @db.Uuid
  developmentProjectId String                  @db.Uuid
  expenseId            String                  @unique @db.Uuid
  vendorPartyId        String?                 @db.Uuid
  category             DevelopmentCostCategory
  amount               Decimal                 @db.Decimal(20, 4)
  currency             String                  @db.Char(3)
  businessDate         DateTime                @db.Date
  allocationNotes      String?                 @db.VarChar(500)
  idempotencyKey       String                  @unique @db.VarChar(180)
  createdAt            DateTime                @default(now()) @db.Timestamptz(6)
  project              DevelopmentProject      @relation(fields: [developmentProjectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  expense              Expense                 @relation(fields: [expenseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  vendor               Party?                  @relation("DevelopmentCostVendor", fields: [vendorPartyId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([developmentProjectId, businessDate], map: "development_cost_project_date_idx")
  @@map("development_costs")
}

model DevelopmentOutputAsset {
  id                   String             @id @db.Uuid
  developmentProjectId String             @db.Uuid
  plotId               String?            @unique @db.Uuid
  propertyId           String             @unique @db.Uuid
  saleListingId        String?            @unique @db.Uuid
  saleReady            Boolean            @default(false)
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)
  project              DevelopmentProject @relation(fields: [developmentProjectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  plot                 DevelopmentPlot?   @relation(fields: [plotId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  property             Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  saleListing          SaleListing?       @relation(fields: [saleListingId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([developmentProjectId, saleReady], map: "development_output_project_idx")
  @@map("development_output_assets")
}
