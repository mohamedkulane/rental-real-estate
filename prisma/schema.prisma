generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                 String              @id @db.Uuid
  singletonKey       Boolean             @unique @default(true)
  code               String              @unique @db.VarChar(32)
  name               String              @db.VarChar(200)
  legalName          String?             @db.VarChar(240)
  displayName        String?             @db.VarChar(200)
  phone              String?             @db.VarChar(40)
  email              String?             @db.VarChar(320)
  address            Json?
  logoMetadata       Json?
  legalPartyId       String?             @unique @db.Uuid
  defaultCurrency    String              @db.Char(3)
  timezone           String              @db.VarChar(64)
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  approval_policies  ApprovalPolicy[]
  branches           Branch[]
  departments        Department[]
  documents          Document[]
  employees          Employee[]
  parties            Party[]             @relation("CompanyParties")
  legalParty         Party?              @relation("CompanyLegalParty", fields: [legalPartyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  properties         Property[]
  roles              Role[]
  serviceEngagements ServiceEngagement[]
  leadSources        LeadSource[]
  leads              Lead[]
  workflowDrafts     WorkflowDraft[]
  rentalListings     RentalListing[]
  saleListings       SaleListing[]
  viewings           Viewing[]
  rentalApplications RentalApplication[]
  reservations       Reservation[]
  tenantProfiles     TenantProfile[]
  leases             Lease[]
  fiscalYears        FiscalYear[]
  accounts           Account[]
  chargeTypes        ChargeType[]
  paymentMethods     PaymentMethod[]
  charges            Charge[]
  invoices           Invoice[]
  chargeAdjustments  ChargeAdjustment[]
  payments           Payment[]
  receipts           Receipt[]
  tenantCredits      TenantCredit[]
  expenses           Expense[]
  ownerStatements    OwnerStatement[]
  ownerPayouts       OwnerPayout[]
  journalEntries     JournalEntry[]
  billingSchedules   BillingSchedule[]
  brokerageDeals     BrokerageDeal[]
  saleOffers         SaleOffer[]
  saleSettlements    SaleSettlement[]
  maintenanceRequests MaintenanceRequest[]
  workOrders         WorkOrder[]
  inspections        Inspection[]
  defectIssues       DefectIssue[]
  portalAccounts     PortalAccount[]
  notifications      Notification[]
  constructionProjects ConstructionProject[]
  constructionContracts ConstructionContract[]
  developmentProjects DevelopmentProject[]

  @@map("companies")
}

model Branch {
  id                  String                     @id @db.Uuid
  companyId           String                     @db.Uuid
  code                String                     @db.VarChar(32)
  name                String                     @db.VarChar(160)
  address             Json?
  phone               String?                    @db.VarChar(40)
  email               String?                    @db.VarChar(320)
  active              Boolean                    @default(true)
  createdAt           DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                   @updatedAt @db.Timestamptz(6)
  approval_requests   ApprovalRequest[]
  audit_logs          AuditLog[]
  company             Company                    @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  employeeAssignments EmployeeBranchAssignment[]
  employee_roles      EmployeeRole[]
  partyAssignments    PartyBranchAssignment[]
  propertyAssignments PropertyBranchAssignment[]
  leads               Lead[]
  leadActivities      LeadActivity[]
  leadAssignments     LeadAssignment[]
  leadBranchHistory   LeadBranchHistory[]
  leadFollowUps       LeadFollowUp[]
  workflowDrafts      WorkflowDraft[]
  rentalListings      RentalListing[]
  saleListings        SaleListing[]
  viewings            Viewing[]
  rentalApplications  RentalApplication[]
  reservations        Reservation[]
  leases              Lease[]
  billingSchedules    BillingSchedule[]
  charges             Charge[]
  invoices            Invoice[]
  chargeAdjustments   ChargeAdjustment[]
  payments            Payment[]
  receipts            Receipt[]
  tenantCredits       TenantCredit[]
  expenses            Expense[]
  ownerStatements     OwnerStatement[]
  ownerPayouts        OwnerPayout[]
  journalEntries      JournalEntry[]
  journalLines        JournalLine[]
  brokerageDeals      BrokerageDeal[]
  saleOffers          SaleOffer[]
  saleSettlements     SaleSettlement[]
  vendorAvailability  VendorBranchAvailability[]
  maintenanceRequests MaintenanceRequest[]
  workOrders          WorkOrder[]
  inspections         Inspection[]
  defectIssues        DefectIssue[]
  constructionProjects ConstructionProject[]
  constructionContracts ConstructionContract[]
  developmentProjects DevelopmentProject[]

  @@unique([companyId, code], map: "uq_branches__company_code")
  @@map("branches")
}

model Department {
  id        String  @id @db.Uuid
  companyId String  @db.Uuid
  code      String  @db.VarChar(32)
  name      String  @db.VarChar(120)
  active    Boolean @default(true)
  companies Company @relation(fields: [companyId], references: [id], onUpdate: NoAction)

  @@unique([companyId, code])
  @@map("departments")
}

model User {
  id                                                String                     @id @db.Uuid
  emailNormalized                                   String                     @unique @db.VarChar(320)
  passwordHash                                      String?                    @db.VarChar(255)
  status                                            UserStatus                 @default(PENDING)
  passwordChangedAt                                 DateTime?                  @db.Timestamptz(6)
  createdAt                                         DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                                         DateTime                   @updatedAt @db.Timestamptz(6)
  audit_logs_audit_logs_actorUserIdTousers          AuditLog[]                 @relation("audit_logs_actorUserIdTousers")
  audit_logs_audit_logs_effectiveActorUserIdTousers AuditLog[]                 @relation("audit_logs_effectiveActorUserIdTousers")
  document_versions                                 DocumentVersion[]
  employee                                          Employee?
  passwordResets                                    PasswordResetToken[]
  sessions                                          Session[]
  serviceEngagementsCreated                         ServiceEngagement[]        @relation("ServiceEngagementCreatedBy")
  serviceEngagementHistory                          ServiceEngagementHistory[] @relation("ServiceEngagementHistoryActor")
  leadSourcesCreated                                LeadSource[]               @relation("LeadSourceCreatedBy")
  leadsCreated                                      Lead[]                     @relation("LeadCreatedBy")
  workflowDraftsCreated                             WorkflowDraft[]            @relation("WorkflowDraftCreatedBy")
  workflowCompletions                               WorkflowCompletion[]       @relation("WorkflowCompletionCaller")
  workflowCommands                                  WorkflowCommand[]
  leadStageChanges                                  LeadStageHistory[]         @relation("LeadStageActor")
  leadIntentChanges                                 LeadIntentHistory[]        @relation("LeadIntentActor")
  leadPreferenceVersions                            LeadPreferenceVersion[]    @relation("LeadPreferenceActor")
  leadAssignmentsChanged                            LeadAssignment[]           @relation("LeadAssignmentActor")
  leadBranchChanges                                 LeadBranchHistory[]        @relation("LeadBranchActor")
  leadActivitiesRecorded                            LeadActivity[]             @relation("LeadActivityRecorder")
  leadFollowUpsCreated                              LeadFollowUp[]             @relation("LeadFollowUpCreator")
  leadFollowUpOutcomes                              LeadFollowUp[]             @relation("LeadFollowUpOutcomeActor")
  leadFollowUpOutcomeHistory                        LeadFollowUpOutcome[]
  rentalListingsCreated                             RentalListing[]            @relation("RentalListingCreatedBy")
  saleListingsCreated                               SaleListing[]              @relation("SaleListingCreatedBy")
  viewingsCreated                                   Viewing[]                  @relation("ViewingCreatedBy")
  rentalApplicationsCreated                         RentalApplication[]        @relation("RentalApplicationCreatedBy")
  reservationsCreated                               Reservation[]              @relation("ReservationCreatedBy")
  leasesCreated                                     Lease[]                    @relation("LeaseCreatedBy")
  leaseVersionsCreated                              LeaseVersion[]             @relation("LeaseVersionCreatedBy")
  renewalsCreated                                   LeaseRenewal[]             @relation("LeaseRenewalCreatedBy")
  moveInsRecorded                                   MoveIn[]                   @relation("MoveInRecordedBy")
  saleOfferEvents                                   SaleOfferEvent[]           @relation("SaleOfferEventActor")
  paymentsReceived                                  Payment[]                  @relation("PaymentReceivedBy")
  maintenanceActivities                             MaintenanceActivity[]      @relation("MaintenanceActivityActor")
  workOrderEvents                                   WorkOrderEvent[]           @relation("WorkOrderEventActor")
  portalAccount                                     PortalAccount?
  notifications                                     Notification[]

  @@map("users")
}

model Session {
  id               String    @id @db.Uuid
  userId           String    @db.Uuid
  tokenHash        String    @unique @db.Char(64)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt        DateTime  @db.Timestamptz(6)
  lastActivityAt   DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  revocationReason String?   @db.VarChar(255)
  ipAddress        String?   @db.VarChar(64)
  userAgent        String?   @db.VarChar(512)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Employee {
  id                                                                       String                     @id @db.Uuid
  companyId                                                                String                     @db.Uuid
  userId                                                                   String?                    @unique @db.Uuid
  partyId                                                                  String                     @unique @db.Uuid
  employeeNumber                                                           String                     @db.VarChar(40)
  accessMode                                                               BranchAccessMode
  jobTitle                                                                 String?                    @db.VarChar(120)
  hireDate                                                                 DateTime?                  @db.Date
  active                                                                   Boolean                    @default(true)
  createdAt                                                                DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                                                                DateTime                   @updatedAt @db.Timestamptz(6)
  approval_decisions_approval_decisions_approverEmployeeIdToemployees      ApprovalDecision[]         @relation("approval_decisions_approverEmployeeIdToemployees")
  approval_decisions_approval_decisions_delegatedFromEmployeeIdToemployees ApprovalDecision[]         @relation("approval_decisions_delegatedFromEmployeeIdToemployees")
  approval_requests                                                        ApprovalRequest[]
  branchAssignments                                                        EmployeeBranchAssignment[]
  roles                                                                    EmployeeRole[]
  companies                                                                Company                    @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  party                                                                    Party                      @relation(fields: [partyId], references: [id], onUpdate: NoAction)
  user                                                                     User?                      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assignedLeads                                                            Lead[]                     @relation("LeadCurrentAssignee")
  leadAssignments                                                          LeadAssignment[]
  responsibleLeadFollowUps                                                 LeadFollowUp[]
  assignedViewings                                                         Viewing[]                  @relation("ViewingAssignedEmployee")
  assignedMaintenanceRequests                                              MaintenanceRequest[]       @relation("MaintenanceAssignedEmployee")
  assignedWorkOrders                                                       WorkOrder[]                @relation("WorkOrderAssignedEmployee")
  inspectionsAsInspector                                                   Inspection[]               @relation("InspectionInspector")
  managedConstructionProjects                                              ConstructionProject[]      @relation("ConstructionProjectManager")
  managedDevelopmentProjects                                               DevelopmentProject[]       @relation("DevelopmentProjectManager")
  assignedConstructionMilestones                                           ConstructionMilestone[]    @relation("ConstructionMilestoneAssignee")
  assignedConstructionWorkPackages                                         ConstructionWorkPackage[]  @relation("ConstructionWorkPackageAssignee")

  @@unique([companyId, employeeNumber])
  @@map("employees")
}

model EmployeeBranchAssignment {
  id            String    @id @db.Uuid
  employeeId    String    @db.Uuid
  branchId      String    @db.Uuid
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  branch        Branch    @relation(fields: [branchId], references: [id], onUpdate: NoAction)
  employee      Employee  @relation(fields: [employeeId], references: [id], onUpdate: NoAction)

  @@unique([employeeId, branchId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
  @@map("employee_branch_assignments")
}

model Role {
  id          String           @id @db.Uuid
  companyId   String           @db.Uuid
  code        String           @db.VarChar(64)
  name        String           @db.VarChar(120)
  active      Boolean          @default(true)
  employees   EmployeeRole[]
  permissions RolePermission[]
  companies   Company          @relation(fields: [companyId], references: [id], onUpdate: NoAction)

  @@unique([companyId, code])
  @@map("roles")
}

model Permission {
  id          String           @id @db.Uuid
  code        String           @unique @db.VarChar(100)
  description String           @db.VarChar(255)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model EmployeeRole {
  id            String    @id @db.Uuid
  employeeId    String    @db.Uuid
  roleId        String    @db.Uuid
  branchId      String?   @db.Uuid
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  branches      Branch?   @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  employee      Employee  @relation(fields: [employeeId], references: [id], onUpdate: NoAction)
  role          Role      @relation(fields: [roleId], references: [id], onUpdate: NoAction)

  @@unique([employeeId, roleId, branchId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
  @@map("employee_roles")
}

model Party {
  id                                                             String                  @id @db.Uuid
  companyId                                                      String                  @db.Uuid
  partyNumber                                                    String                  @db.VarChar(40)
  kind                                                           PartyKind
  displayName                                                    String                  @db.VarChar(240)
  active                                                         Boolean                 @default(true)
  createdAt                                                      DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                                                      DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  addresses                                                      Address[]
  contacts                                                       ContactPoint[]
  employee                                                       Employee?
  organization                                                   OrganizationProfile?
  owner                                                          OwnerProfile?
  company                                                        Company                 @relation("CompanyParties", fields: [companyId], references: [id], onUpdate: NoAction)
  representedCompany                                             Company?                @relation("CompanyLegalParty")
  branchAssignments                                              PartyBranchAssignment[]
  party_relationships_party_relationships_sourcePartyIdToparties PartyRelationship[]     @relation("party_relationships_sourcePartyIdToparties")
  party_relationships_party_relationships_targetPartyIdToparties PartyRelationship[]     @relation("party_relationships_targetPartyIdToparties")
  person                                                         PersonProfile?
  propertyOwnerships                                             PropertyOwnership[]
  leads                                                          Lead[]
  tenant                                                         TenantProfile?
  rentalApplications                                             RentalApplication[]
  leaseParties                                                   LeaseParty[]
  chargesAsDebtor                                              Charge[]            @relation("ChargeDebtor")
  invoicesAsDebtor                                             Invoice[]           @relation("InvoiceDebtor")
  paymentsAsPayer                                              Payment[]           @relation("PaymentPayer")
  receiptsAsPayer                                              Receipt[]           @relation("ReceiptPayer")
  tenantCredits                                                TenantCredit[]      @relation("TenantCreditParty")
  expensesAsVendor                                             Expense[]           @relation("ExpenseVendor")
  expensesAsOwner                                              Expense[]           @relation("ExpenseOwner")
  ownerStatements                                              OwnerStatement[]    @relation("OwnerStatementOwner")
  ownerPayouts                                                 OwnerPayout[]       @relation("OwnerPayoutOwner")
  journalLinesAsOwner                                          JournalLine[]       @relation("JournalLineOwner")
  journalLinesAsTenant                                         JournalLine[]       @relation("JournalLineTenant")
  journalLinesAsVendor                                         JournalLine[]       @relation("JournalLineVendor")
  saleOffersAsBuyer                                            SaleOffer[]         @relation("SaleOfferBuyer")
  ownerPayoutLines                                             OwnerPayoutLine[]   @relation("OwnerPayoutLineOwner")
  vendorProfile                                                VendorProfile?
  maintenanceAsTenant                                          MaintenanceRequest[] @relation("MaintenanceTenant")
  maintenanceAsReporter                                        MaintenanceRequest[] @relation("MaintenanceReporter")
  inspectionsAsTenant                                          Inspection[]         @relation("InspectionTenant")
  portalAccount                                                PortalAccount?
  constructionProjectsAsClient                                 ConstructionProject[] @relation("ConstructionProjectClient")
  constructionContractsAsClient                                ConstructionContract[] @relation("ConstructionContractClient")
  constructionWorkPackagesAsVendor                             ConstructionWorkPackage[] @relation("ConstructionWorkPackageVendor")
  constructionCostsAsVendor                                    ConstructionCost[] @relation("ConstructionCostVendor")
  developmentCostsAsVendor                                     DevelopmentCost[] @relation("DevelopmentCostVendor")

  @@unique([companyId, partyNumber])
  @@map("parties")
}

model PartyBranchAssignment {
  id            String    @id @db.Uuid
  partyId       String    @db.Uuid
  branchId      String    @db.Uuid
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  branch        Branch    @relation(fields: [branchId], references: [id])
  party         Party     @relation(fields: [partyId], references: [id])

  @@unique([partyId, branchId, effectiveFrom])
  @@index([partyId, effectiveFrom])
  @@index([branchId, effectiveFrom])
  @@map("party_branch_assignments")
}

model PersonProfile {
  partyId                String    @id @db.Uuid
  givenName              String    @db.VarChar(120)
  familyName             String    @db.VarChar(120)
  preferredName          String?   @db.VarChar(120)
  birthDate              DateTime? @db.Date
  nationalityCode        String?   @db.Char(2)
  identificationMetadata Json?
  party                  Party     @relation(fields: [partyId], references: [id], onUpdate: NoAction)

  @@map("person_profiles")
}

model OrganizationProfile {
  partyId            String  @id @db.Uuid
  legalName          String  @db.VarChar(240)
  tradingName        String? @db.VarChar(240)
  registrationNumber String? @db.VarChar(100)
  contactPersonName  String? @db.VarChar(200)
  party              Party   @relation(fields: [partyId], references: [id], onUpdate: NoAction)

  @@map("organization_profiles")
}

model OwnerProfile {
  partyId                 String      @id @db.Uuid
  ownerNumber             String      @unique @db.VarChar(40)
  status                  OwnerStatus @default(PROSPECTIVE)
  communicationPreference String?     @db.VarChar(30)
  notes                   String?
  verifiedAt              DateTime?   @db.Timestamptz(6)
  createdAt               DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  party                   Party       @relation(fields: [partyId], references: [id], onUpdate: NoAction)

  @@map("owner_profiles")
}

model ContactPoint {
  id             String  @id @db.Uuid
  partyId        String  @db.Uuid
  type           String  @db.VarChar(30)
  valueEncrypted String
  normalizedHash String? @db.VarChar(128)
  primary        Boolean @default(false)
  party          Party   @relation(fields: [partyId], references: [id], onUpdate: NoAction)

  @@index([normalizedHash])
  @@map("contact_points")
}

model Address {
  id          String  @id @db.Uuid
  partyId     String  @db.Uuid
  type        String  @db.VarChar(30)
  line1       String  @db.VarChar(200)
  city        String? @db.VarChar(100)
  countryCode String  @db.Char(2)
  party       Party   @relation(fields: [partyId], references: [id], onUpdate: NoAction)

  @@map("addresses")
}

model PartyRelationship {
  id                                                 String    @id @db.Uuid
  sourcePartyId                                      String    @db.Uuid
  targetPartyId                                      String    @db.Uuid
  type                                               String    @db.VarChar(50)
  effectiveFrom                                      DateTime  @db.Date
  effectiveTo                                        DateTime? @db.Date
  parties_party_relationships_sourcePartyIdToparties Party     @relation("party_relationships_sourcePartyIdToparties", fields: [sourcePartyId], references: [id], onUpdate: NoAction)
  parties_party_relationships_targetPartyIdToparties Party     @relation("party_relationships_targetPartyIdToparties", fields: [targetPartyId], references: [id], onUpdate: NoAction)

  @@index([sourcePartyId, type])
  @@map("party_relationships")
}

model Property {
  id                          String                              @id @db.Uuid
  companyId                   String                              @db.Uuid
  propertyCode                String                              @db.VarChar(40)
  name                        String                              @db.VarChar(200)
  propertyType                PropertyType
  status                      PropertyStatus                      @default(DRAFT)
  description                 String?
  addressLine1                String?                             @db.VarChar(200)
  city                        String                              @db.VarChar(100)
  district                    String?                             @db.VarChar(100)
  neighborhood                String?                             @db.VarChar(100)
  landmark                    String?                             @db.VarChar(200)
  latitude                    Decimal?                            @db.Decimal(9, 6)
  longitude                   Decimal?                            @db.Decimal(9, 6)
  plotArea                    Decimal?                            @db.Decimal(20, 6)
  plotAreaUnit                AreaUnit?
  createdAt                   DateTime                            @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                            @default(now()) @updatedAt @db.Timestamptz(6)
  buildings                   Building[]
  company                     Company                             @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  amenities                   PropertyAmenity[]
  branchAssignments           PropertyBranchAssignment[]
  ownerships                  PropertyOwnership[]
  spaces                      RentableSpace[]
  propertyLifecycleHistories  PropertyLifecycleHistory[]
  serviceEngagements          ServiceEngagement[]
  buyLeadPreferences          BuyLeadPreference[]
  sellLeadPreferences         SellLeadPreference[]
  constructionLeadPreferences ConstructionServiceLeadPreference[]
  saleListings                SaleListing[]
  charges                     Charge[]
  expenses                    Expense[]
  ownerStatements             OwnerStatement[]
  ownerPayoutLines            OwnerPayoutLine[]
  ownerPayouts                OwnerPayout[]
  journalLines                JournalLine[]
  saleOffers                  SaleOffer[]
  saleSettlements             SaleSettlement[]
  maintenanceRequests         MaintenanceRequest[]
  workOrders                  WorkOrder[]
  inspections                 Inspection[]
  defectIssues                DefectIssue[]
  constructionProjects        ConstructionProject[]
  developmentProjects         DevelopmentProject[] @relation("DevelopmentSourceProperty")
  developmentOutputAssets     DevelopmentOutputAsset[]

  @@unique([companyId, propertyCode], map: "uq_properties_company_code")
  @@index([companyId, status, propertyType], map: "properties_company_status_type_idx")
  @@map("properties")
}

model PropertyLifecycleHistory {
  id            String         @id @db.Uuid
  propertyId    String         @db.Uuid
  status        PropertyStatus
  effectiveFrom DateTime       @db.Date
  effectiveTo   DateTime?      @db.Date
  reason        String         @db.VarChar(500)
  actorUserId   String         @db.Uuid
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([propertyId, effectiveFrom])
  @@index([propertyId, status, effectiveFrom])
  @@map("property_lifecycle_history")
}

model Building {
  id             String          @id @db.Uuid
  propertyId     String          @db.Uuid
  buildingCode   String          @db.VarChar(40)
  name           String          @db.VarChar(160)
  numberOfFloors Int?
  attributes     Json?
  status         BuildingStatus  @default(ACTIVE)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  property       Property        @relation(fields: [propertyId], references: [id], onUpdate: NoAction)
  spaces         RentableSpace[]

  @@unique([propertyId, buildingCode], map: "uq_buildings_property_code")
  @@map("buildings")
}

model PropertyBranchAssignment {
  id            String    @id @db.Uuid
  propertyId    String    @db.Uuid
  branchId      String    @db.Uuid
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  branch        Branch    @relation(fields: [branchId], references: [id], onUpdate: NoAction)
  property      Property  @relation(fields: [propertyId], references: [id], onUpdate: NoAction)

  @@unique([propertyId, effectiveFrom], map: "uq_property_branch_effective")
  @@index([branchId, effectiveFrom], map: "property_branch_branch_date_idx")
  @@index([propertyId, effectiveFrom], map: "property_branch_property_date_idx")
  @@map("property_branch_assignments")
}

model PropertyOwnership {
  id               String                     @id @db.Uuid
  propertyId       String                     @db.Uuid
  ownerPartyId     String                     @db.Uuid
  ownershipPercent Decimal                    @db.Decimal(9, 6)
  effectiveFrom    DateTime                   @db.Date
  effectiveTo      DateTime?                  @db.Date
  entitlements     PropertyOwnerEntitlement[]
  owner            Party                      @relation(fields: [ownerPartyId], references: [id], onUpdate: NoAction)
  property         Property                   @relation(fields: [propertyId], references: [id], onUpdate: NoAction)

  @@unique([propertyId, ownerPartyId, effectiveFrom], map: "uq_property_owner_effective")
  @@index([propertyId, effectiveFrom], map: "property_ownership_property_date_idx")
  @@map("property_ownerships")
}

model PropertyOwnerEntitlement {
  id            String            @id @db.Uuid
  ownershipId   String            @db.Uuid
  payoutPercent Decimal           @db.Decimal(9, 6)
  effectiveFrom DateTime          @db.Date
  effectiveTo   DateTime?         @db.Date
  ownership     PropertyOwnership @relation(fields: [ownershipId], references: [id], onUpdate: NoAction)

  @@unique([ownershipId, effectiveFrom], map: "uq_owner_entitlement_effective")
  @@index([ownershipId, effectiveFrom], map: "owner_entitlement_ownership_date_idx")
  @@map("property_owner_entitlements")
