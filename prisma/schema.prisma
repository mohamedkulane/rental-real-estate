model ConstructionWorkPackage {
  id                    String                           @id @db.Uuid
  constructionProjectId String                           @db.Uuid
  milestoneId           String?                          @db.Uuid
  title                 String                           @db.VarChar(200)
  description           String?                          @db.VarChar(2000)
  assigneeEmployeeId    String?                          @db.Uuid
  vendorPartyId         String?                          @db.Uuid
  priority              ConstructionWorkPackagePriority  @default(MEDIUM)
  scheduledStart        DateTime?                        @db.Date
  scheduledEnd          DateTime?                        @db.Date
  actualStart           DateTime?                        @db.Date
  actualEnd             DateTime?                        @db.Date
  status                ConstructionWorkPackageStatus    @default(PLANNED)
  estimatedCost         Decimal?                         @db.Decimal(20, 4)
  actualCost            Decimal?                         @db.Decimal(20, 4)
  notes                 String?                          @db.VarChar(2000)
  createdAt             DateTime                         @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                         @updatedAt @db.Timestamptz(6)
  project               ConstructionProject              @relation(fields: [constructionProjectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  milestone             ConstructionMilestone?           @relation(fields: [milestoneId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assignee              Employee?                        @relation("ConstructionWorkPackageAssignee", fields: [assigneeEmployeeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  vendor                Party?                           @relation("ConstructionWorkPackageVendor", fields: [vendorPartyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  costs                 ConstructionCost[]
  blockers              ConstructionWorkPackageDependency[] @relation("WorkPackageBlocked")
  blocking              ConstructionWorkPackageDependency[] @relation("WorkPackageBlocking")

  @@index([constructionProjectId, status], map: "construction_work_package_project_idx")
