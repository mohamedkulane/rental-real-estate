generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                String           @id @db.Uuid
  singletonKey      Boolean          @unique @default(true)
  code              String           @unique @db.VarChar(32)
  name              String           @db.VarChar(200)
  legalName         String?          @db.VarChar(240)
  displayName       String?          @db.VarChar(200)
  phone             String?          @db.VarChar(40)
  email             String?          @db.VarChar(320)
  address           Json?
  logoMetadata      Json?
  defaultCurrency   String           @db.Char(3)
  timezone          String           @db.VarChar(64)
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(6)
  approval_policies ApprovalPolicy[]
  branches          Branch[]
  departments       Department[]
  documents         Document[]
  employees         Employee[]
  parties           Party[]
  properties        Property[]
  roles             Role[]

  @@map("companies")
}

model Branch {
  id                  String                     @id @db.Uuid
  companyId           String                     @db.Uuid
  code                String                     @db.VarChar(32)
  name                String                     @db.VarChar(160)
  address             Json?
  phone               String?                    @db.VarChar(40)
  email               String?                    @db.VarChar(320)
  active              Boolean                    @default(true)
  createdAt           DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                   @updatedAt @db.Timestamptz(6)
  approval_requests   ApprovalRequest[]
  audit_logs          AuditLog[]
  company             Company                    @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  employeeAssignments EmployeeBranchAssignment[]
  employee_roles      EmployeeRole[]
  partyAssignments    PartyBranchAssignment[]
  propertyAssignments PropertyBranchAssignment[]

  @@unique([companyId, code], map: "uq_branches__company_code")
  @@map("branches")
}

model Department {
  id        String  @id @db.Uuid
  companyId String  @db.Uuid
  code      String  @db.VarChar(32)
  name      String  @db.VarChar(120)
  active    Boolean @default(true)
  companies Company @relation(fields: [companyId], references: [id], onUpdate: NoAction)

  @@unique([companyId, code])
  @@map("departments")
}

model User {
  id                                                String               @id @db.Uuid
  emailNormalized                                   String               @unique @db.VarChar(320)
  passwordHash                                      String?              @db.VarChar(255)
  status                                            UserStatus           @default(PENDING)
  passwordChangedAt                                 DateTime?            @db.Timestamptz(6)
  createdAt                                         DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt                                         DateTime             @updatedAt @db.Timestamptz(6)
  audit_logs_audit_logs_actorUserIdTousers          AuditLog[]           @relation("audit_logs_actorUserIdTousers")
  audit_logs_audit_logs_effectiveActorUserIdTousers AuditLog[]           @relation("audit_logs_effectiveActorUserIdTousers")
  document_versions                                 DocumentVersion[]
  employee                                          Employee?
  passwordResets                                    PasswordResetToken[]
  sessions                                          Session[]

  @@map("users")
}

model Session {
  id               String    @id @db.Uuid
  userId           String    @db.Uuid
  tokenHash        String    @unique @db.Char(64)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt        DateTime  @db.Timestamptz(6)
  lastActivityAt   DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)
  revocationReason String?   @db.VarChar(255)
  ipAddress        String?   @db.VarChar(64)
  userAgent        String?   @db.VarChar(512)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Employee {
  id                                                                       String                     @id @db.Uuid
  companyId                                                                String                     @db.Uuid
  userId                                                                   String?                    @unique @db.Uuid
  partyId                                                                  String                     @unique @db.Uuid
  employeeNumber                                                           String                     @db.VarChar(40)
  accessMode                                                               BranchAccessMode
  jobTitle                                                                 String?                    @db.VarChar(120)
  hireDate                                                                 DateTime?                  @db.Date
  active                                                                   Boolean                    @default(true)
  createdAt                                                                DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                                                                DateTime                   @updatedAt @db.Timestamptz(6)
  approval_decisions_approval_decisions_approverEmployeeIdToemployees      ApprovalDecision[]         @relation("approval_decisions_approverEmployeeIdToemployees")
  approval_decisions_approval_decisions_delegatedFromEmployeeIdToemployees ApprovalDecision[]         @relation("approval_decisions_delegatedFromEmployeeIdToemployees")
  approval_requests                                                        ApprovalRequest[]
  branchAssignments                                                        EmployeeBranchAssignment[]
  roles                                                                    EmployeeRole[]
  companies                                                                Company                    @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  party                                                                    Party                      @relation(fields: [partyId], references: [id], onUpdate: NoAction)
  user                                                                     User?                      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([companyId, employeeNumber])
  @@map("employees")
}

model EmployeeBranchAssignment {
  id            String    @id @db.Uuid
  employeeId    String    @db.Uuid
  branchId      String    @db.Uuid
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  branch        Branch    @relation(fields: [branchId], references: [id], onUpdate: NoAction)
  employee      Employee  @relation(fields: [employeeId], references: [id], onUpdate: NoAction)

  @@unique([employeeId, branchId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
  @@map("employee_branch_assignments")
}

model Role {
  id          String           @id @db.Uuid
  companyId   String           @db.Uuid
  code        String           @db.VarChar(64)
  name        String           @db.VarChar(120)
  active      Boolean          @default(true)
  employees   EmployeeRole[]
  permissions RolePermission[]
  companies   Company          @relation(fields: [companyId], references: [id], onUpdate: NoAction)

  @@unique([companyId, code])
  @@map("roles")
}

model Permission {
  id          String           @id @db.Uuid
  code        String           @unique @db.VarChar(100)
  description String           @db.VarChar(255)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model EmployeeRole {
  id            String    @id @db.Uuid
  employeeId    String    @db.Uuid
  roleId        String    @db.Uuid
  branchId      String?   @db.Uuid
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  branches      Branch?   @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  employee      Employee  @relation(fields: [employeeId], references: [id], onUpdate: NoAction)
  role          Role      @relation(fields: [roleId], references: [id], onUpdate: NoAction)

  @@unique([employeeId, roleId, branchId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
  @@map("employee_roles")
}

model Party {
  id                                                             String                  @id @db.Uuid
  companyId                                                      String                  @db.Uuid
  partyNumber                                                    String                  @db.VarChar(40)
  kind                                                           PartyKind
  displayName                                                    String                  @db.VarChar(240)
  active                                                         Boolean                 @default(true)
  createdAt                                                      DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt                                                      DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  addresses                                                      Address[]
  contacts                                                       ContactPoint[]
  employee                                                       Employee?
  organization                                                   OrganizationProfile?
  owner                                                          OwnerProfile?
  company                                                        Company                 @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  branchAssignments                                              PartyBranchAssignment[]
  party_relationships_party_relationships_sourcePartyIdToparties PartyRelationship[]     @relation("party_relationships_sourcePartyIdToparties")
  party_relationships_party_relationships_targetPartyIdToparties PartyRelationship[]     @relation("party_relationships_targetPartyIdToparties")
  person                                                         PersonProfile?
  propertyOwnerships                                             PropertyOwnership[]

  @@unique([companyId, partyNumber])
  @@map("parties")
}

model PartyBranchAssignment {
  id            String    @id @db.Uuid
  partyId       String    @db.Uuid
  branchId      String    @db.Uuid
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  branch        Branch    @relation(fields: [branchId], references: [id])
  party         Party     @relation(fields: [partyId], references: [id])

  @@unique([partyId, branchId, effectiveFrom])
  @@index([partyId, effectiveFrom])
  @@index([branchId, effectiveFrom])
  @@map("party_branch_assignments")
}

model PersonProfile {
  partyId                String    @id @db.Uuid
  givenName              String    @db.VarChar(120)
  familyName             String    @db.VarChar(120)
  preferredName          String?   @db.VarChar(120)
  birthDate              DateTime? @db.Date
  nationalityCode        String?   @db.Char(2)
  identificationMetadata Json?
  party                  Party     @relation(fields: [partyId], references: [id], onUpdate: NoAction)

  @@map("person_profiles")
}

model OrganizationProfile {
  partyId            String  @id @db.Uuid
  legalName          String  @db.VarChar(240)
  tradingName        String? @db.VarChar(240)
  registrationNumber String? @db.VarChar(100)
  contactPersonName  String? @db.VarChar(200)
  party              Party   @relation(fields: [partyId], references: [id], onUpdate: NoAction)

  @@map("organization_profiles")
}

model OwnerProfile {
  partyId                 String      @id @db.Uuid
  ownerNumber             String      @unique @db.VarChar(40)
  status                  OwnerStatus @default(PROSPECTIVE)
  communicationPreference String?     @db.VarChar(30)
  notes                   String?
  verifiedAt              DateTime?   @db.Timestamptz(6)
  createdAt               DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  party                   Party       @relation(fields: [partyId], references: [id], onUpdate: NoAction)

  @@map("owner_profiles")
}

model ContactPoint {
  id             String  @id @db.Uuid
  partyId        String  @db.Uuid
  type           String  @db.VarChar(30)
  valueEncrypted String
  normalizedHash String? @db.VarChar(128)
  primary        Boolean @default(false)
  party          Party   @relation(fields: [partyId], references: [id], onUpdate: NoAction)

  @@index([normalizedHash])
  @@map("contact_points")
}

model Address {
  id          String  @id @db.Uuid
  partyId     String  @db.Uuid
  type        String  @db.VarChar(30)
  line1       String  @db.VarChar(200)
  city        String? @db.VarChar(100)
  countryCode String  @db.Char(2)
  party       Party   @relation(fields: [partyId], references: [id], onUpdate: NoAction)

  @@map("addresses")
}

model PartyRelationship {
  id                                                 String    @id @db.Uuid
  sourcePartyId                                      String    @db.Uuid
  targetPartyId                                      String    @db.Uuid
  type                                               String    @db.VarChar(50)
  effectiveFrom                                      DateTime  @db.Date
  effectiveTo                                        DateTime? @db.Date
  parties_party_relationships_sourcePartyIdToparties Party     @relation("party_relationships_sourcePartyIdToparties", fields: [sourcePartyId], references: [id], onUpdate: NoAction)
  parties_party_relationships_targetPartyIdToparties Party     @relation("party_relationships_targetPartyIdToparties", fields: [targetPartyId], references: [id], onUpdate: NoAction)

  @@index([sourcePartyId, type])
  @@map("party_relationships")
}

model Property {
  id                         String                     @id @db.Uuid
  companyId                  String                     @db.Uuid
  propertyCode               String                     @db.VarChar(40)
  name                       String                     @db.VarChar(200)
  propertyType               PropertyType
  status                     PropertyStatus             @default(DRAFT)
  description                String?
  addressLine1               String?                    @db.VarChar(200)
  city                       String                     @db.VarChar(100)
  district                   String?                    @db.VarChar(100)
  neighborhood               String?                    @db.VarChar(100)
  landmark                   String?                    @db.VarChar(200)
  latitude                   Decimal?                   @db.Decimal(9, 6)
  longitude                  Decimal?                   @db.Decimal(9, 6)
  plotArea                   Decimal?                   @db.Decimal(20, 6)
  plotAreaUnit               AreaUnit?
  createdAt                  DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                   @default(now()) @updatedAt @db.Timestamptz(6)
  buildings                  Building[]
  company                    Company                    @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  amenities                  PropertyAmenity[]
  branchAssignments          PropertyBranchAssignment[]
  ownerships                 PropertyOwnership[]
  spaces                     RentableSpace[]
  propertyLifecycleHistories PropertyLifecycleHistory[]

  @@unique([companyId, propertyCode], map: "uq_properties_company_code")
  @@index([companyId, status, propertyType], map: "properties_company_status_type_idx")
  @@map("properties")
}

model PropertyLifecycleHistory {
  id            String         @id @db.Uuid
  propertyId    String         @db.Uuid
  status        PropertyStatus
  effectiveFrom DateTime       @db.Date
  effectiveTo   DateTime?      @db.Date
  reason        String         @db.VarChar(500)
  actorUserId   String         @db.Uuid
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([propertyId, effectiveFrom])
  @@index([propertyId, status, effectiveFrom])
  @@map("property_lifecycle_history")
}

model Building {
  id             String          @id @db.Uuid
  propertyId     String          @db.Uuid
  buildingCode   String          @db.VarChar(40)
  name           String          @db.VarChar(160)
  numberOfFloors Int?
  attributes     Json?
  status         BuildingStatus  @default(ACTIVE)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  property       Property        @relation(fields: [propertyId], references: [id], onUpdate: NoAction)
  spaces         RentableSpace[]

  @@unique([propertyId, buildingCode], map: "uq_buildings_property_code")
  @@map("buildings")
}

model PropertyBranchAssignment {
  id            String    @id @db.Uuid
  propertyId    String    @db.Uuid
  branchId      String    @db.Uuid
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  branch        Branch    @relation(fields: [branchId], references: [id], onUpdate: NoAction)
  property      Property  @relation(fields: [propertyId], references: [id], onUpdate: NoAction)

  @@unique([propertyId, effectiveFrom], map: "uq_property_branch_effective")
  @@index([branchId, effectiveFrom], map: "property_branch_branch_date_idx")
  @@index([propertyId, effectiveFrom], map: "property_branch_property_date_idx")
  @@map("property_branch_assignments")
}

model PropertyOwnership {
  id               String                     @id @db.Uuid
  propertyId       String                     @db.Uuid
  ownerPartyId     String                     @db.Uuid
  ownershipPercent Decimal                    @db.Decimal(9, 6)
  effectiveFrom    DateTime                   @db.Date
  effectiveTo      DateTime?                  @db.Date
  entitlements     PropertyOwnerEntitlement[]
  owner            Party                      @relation(fields: [ownerPartyId], references: [id], onUpdate: NoAction)
  property         Property                   @relation(fields: [propertyId], references: [id], onUpdate: NoAction)

  @@unique([propertyId, ownerPartyId, effectiveFrom], map: "uq_property_owner_effective")
  @@index([propertyId, effectiveFrom], map: "property_ownership_property_date_idx")
  @@map("property_ownerships")
}

model PropertyOwnerEntitlement {
  id            String            @id @db.Uuid
  ownershipId   String            @db.Uuid
  payoutPercent Decimal           @db.Decimal(9, 6)
  effectiveFrom DateTime          @db.Date
  effectiveTo   DateTime?         @db.Date
  ownership     PropertyOwnership @relation(fields: [ownershipId], references: [id], onUpdate: NoAction)

  @@unique([ownershipId, effectiveFrom], map: "uq_owner_entitlement_effective")
  @@index([ownershipId, effectiveFrom], map: "owner_entitlement_ownership_date_idx")
  @@map("property_owner_entitlements")
}

model RentableSpaceType {
  id     String          @id @db.Uuid
  code   String          @unique @db.VarChar(50)
  name   String          @db.VarChar(100)
  active Boolean         @default(true)
  spaces RentableSpace[]

  @@map("rentable_space_types")
}

model RentableSpace {
  id                                                                    String                       @id @db.Uuid
  propertyId                                                            String                       @db.Uuid
  buildingId                                                            String?                      @db.Uuid
  typeId                                                                String                       @db.Uuid
  spaceCode                                                             String                       @db.VarChar(50)
  name                                                                  String                       @db.VarChar(160)
  status                                                                RentableSpaceStatus          @default(DRAFT)
  createdAt                                                             DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt                                                             DateTime                     @default(now()) @updatedAt @db.Timestamptz(6)
  commercialProfile                                                     CommercialSpaceProfile?
  landProfile                                                           LandSpaceProfile?
  childRelations                                                        RentableSpaceParentHistory[] @relation("ChildSpace")
  parentRelations                                                       RentableSpaceParentHistory[] @relation("ParentSpace")
  versions                                                              RentableSpaceVersion[]
  building                                                              Building?                    @relation(fields: [buildingId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  property                                                              Property                     @relation(fields: [propertyId], references: [id], onUpdate: NoAction)
  type                                                                  RentableSpaceType            @relation(fields: [typeId], references: [id], onUpdate: NoAction)
  residentialProfile                                                    ResidentialSpaceProfile?
  amenities                                                             SpaceAmenity[]
  space_successors_space_successors_predecessorSpaceIdTorentable_spaces SpaceSuccessor[]             @relation("space_successors_predecessorSpaceIdTorentable_spaces")
  space_successors_space_successors_successorSpaceIdTorentable_spaces   SpaceSuccessor[]             @relation("space_successors_successorSpaceIdTorentable_spaces")

  @@unique([propertyId, spaceCode], map: "uq_rentable_space_property_code")
  @@index([propertyId, status, typeId], map: "rentable_space_property_status_type_idx")
  @@map("rentable_spaces")
}

model RentableSpaceVersion {
  id              String        @id @db.Uuid
  rentableSpaceId String        @db.Uuid
  versionNo       Int
  effectiveFrom   DateTime      @db.Date
  effectiveTo     DateTime?     @db.Date
  label           String?       @db.VarChar(160)
  usableArea      Decimal?      @db.Decimal(20, 6)
  totalArea       Decimal?      @db.Decimal(20, 6)
  areaUnit        AreaUnit?
  floorNumber     Int?
  capacity        Int?
  attributes      Json?
  space           RentableSpace @relation(fields: [rentableSpaceId], references: [id], onUpdate: NoAction)

  @@unique([rentableSpaceId, effectiveFrom], map: "uq_space_version_effective")
  @@unique([rentableSpaceId, versionNo], map: "uq_space_version_number")
  @@index([rentableSpaceId, effectiveFrom], map: "space_version_space_date_idx")
  @@map("rentable_space_versions")
}

model RentableSpaceParentHistory {
  id            String        @id @db.Uuid
  childSpaceId  String        @db.Uuid
  parentSpaceId String        @db.Uuid
  effectiveFrom DateTime      @db.Date
  effectiveTo   DateTime?     @db.Date
  child         RentableSpace @relation("ChildSpace", fields: [childSpaceId], references: [id], onUpdate: NoAction)
  parent        RentableSpace @relation("ParentSpace", fields: [parentSpaceId], references: [id], onUpdate: NoAction)

  @@unique([childSpaceId, effectiveFrom], map: "uq_space_parent_effective")
  @@index([childSpaceId, effectiveFrom], map: "space_parent_child_date_idx")
  @@index([parentSpaceId, effectiveFrom], map: "space_parent_parent_date_idx")
  @@map("rentable_space_parent_history")
}

model SpaceSuccessor {
  predecessorSpaceId                                                   String        @db.Uuid
  successorSpaceId                                                     String        @db.Uuid
  relationType                                                         String        @db.VarChar(20)
  effectiveDate                                                        DateTime      @db.Date
  rentable_spaces_space_successors_predecessorSpaceIdTorentable_spaces RentableSpace @relation("space_successors_predecessorSpaceIdTorentable_spaces", fields: [predecessorSpaceId], references: [id], onUpdate: NoAction)
  rentable_spaces_space_successors_successorSpaceIdTorentable_spaces   RentableSpace @relation("space_successors_successorSpaceIdTorentable_spaces", fields: [successorSpaceId], references: [id], onUpdate: NoAction)

  @@id([predecessorSpaceId, successorSpaceId])
  @@map("space_successors")
}

model LandSpaceProfile {
  rentableSpaceId     String        @id @db.Uuid
  dimensions          String?       @db.VarChar(160)
  permittedUse        String        @db.VarChar(200)
  currentUse          String?       @db.VarChar(200)
  boundaryDescription String?
  roadAccess          String?       @db.VarChar(200)
  fenced              Boolean?
  space               RentableSpace @relation(fields: [rentableSpaceId], references: [id], onUpdate: NoAction)

  @@map("land_space_profiles")
}

model ResidentialSpaceProfile {
  rentableSpaceId String        @id @db.Uuid
  bedrooms        Int?
  bathrooms       Decimal?      @db.Decimal(4, 1)
  kitchens        Int?
  livingRooms     Int?
  balconies       Int?
  furnishedStatus String?       @db.VarChar(30)
  space           RentableSpace @relation(fields: [rentableSpaceId], references: [id], onUpdate: NoAction)

  @@map("residential_space_profiles")
}

model CommercialSpaceProfile {
  rentableSpaceId String        @id @db.Uuid
  frontageMeters  Decimal?      @db.Decimal(12, 4)
  classification  String?       @db.VarChar(60)
  space           RentableSpace @relation(fields: [rentableSpaceId], references: [id], onUpdate: NoAction)

  @@map("commercial_space_profiles")
}

model Amenity {
  id                  String            @id @db.Uuid
  code                String            @unique @db.VarChar(50)
  name                String            @db.VarChar(100)
  active              Boolean           @default(true)
  propertyAssignments PropertyAmenity[]
  spaceAssignments    SpaceAmenity[]

  @@map("amenities")
}

model PropertyAmenity {
  propertyId String   @db.Uuid
  amenityId  String   @db.Uuid
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onUpdate: NoAction)
  property   Property @relation(fields: [propertyId], references: [id], onUpdate: NoAction)

  @@id([propertyId, amenityId])
  @@map("property_amenities")
}

model SpaceAmenity {
  rentableSpaceId String        @db.Uuid
  amenityId       String        @db.Uuid
  amenity         Amenity       @relation(fields: [amenityId], references: [id], onUpdate: NoAction)
  space           RentableSpace @relation(fields: [rentableSpaceId], references: [id], onUpdate: NoAction)

  @@id([rentableSpaceId, amenityId])
  @@map("space_amenities")
}

model ApprovalPolicy {
  id            String            @id @db.Uuid
  companyId     String            @db.Uuid
  code          String            @db.VarChar(60)
  name          String            @db.VarChar(120)
  effectiveFrom DateTime          @db.Date
  effectiveTo   DateTime?         @db.Date
  active        Boolean           @default(true)
  companies     Company           @relation(fields: [companyId], references: [id], onUpdate: NoAction)
  requests      ApprovalRequest[]
  rules         ApprovalRule[]

  @@unique([companyId, code, effectiveFrom])
  @@map("approval_policies")
}

model ApprovalRule {
  id              String         @id @db.Uuid
  policyId        String         @db.Uuid
  actionType      String         @db.VarChar(60)
  minAmount       Decimal?       @db.Decimal(20, 4)
  maxAmount       Decimal?       @db.Decimal(20, 4)
  currency        String?        @db.Char(3)
  sequence        Int
  makerChecker    Boolean        @default(true)
  allowDelegation Boolean        @default(false)
  policy          ApprovalPolicy @relation(fields: [policyId], references: [id], onUpdate: NoAction)

  @@map("approval_rules")
}

model ApprovalRequest {
  id              String         @id @db.Uuid
  policyId        String         @db.Uuid
  makerEmployeeId String         @db.Uuid
  branchId        String?        @db.Uuid
  actionType      String         @db.VarChar(60)
  targetType      String         @db.VarChar(60)
  targetId        String         @db.Uuid
  amount          Decimal?       @db.Decimal(20, 4)
  currency        String?        @db.Char(3)
  status          ApprovalStatus
  correlationId   String?        @db.Uuid
  branches        Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  employees       Employee       @relation(fields: [makerEmployeeId], references: [id], onUpdate: NoAction)
  policy          ApprovalPolicy @relation(fields: [policyId], references: [id], onUpdate: NoAction)
  steps           ApprovalStep[]

  @@index([status, branchId])
  @@map("approval_requests")
}

model ApprovalStep {
  id               String             @id @db.Uuid
  requestId        String             @db.Uuid
  sequence         Int
  status           String             @db.VarChar(30)
  requiredRoleCode String?            @db.VarChar(60)
  decisions        ApprovalDecision[]
  request          ApprovalRequest    @relation(fields: [requestId], references: [id], onUpdate: NoAction)

  @@unique([requestId, sequence])
  @@map("approval_steps")
}

model ApprovalDecision {
  id                                                              String       @id @db.Uuid
  stepId                                                          String       @db.Uuid
  approverEmployeeId                                              String       @db.Uuid
  outcome                                                         String       @db.VarChar(20)
  reason                                                          String?
  delegatedFromEmployeeId                                         String?      @db.Uuid
  emergencyOverride                                               Boolean      @default(false)
  decidedAt                                                       DateTime     @default(now()) @db.Timestamptz(6)
  employees_approval_decisions_approverEmployeeIdToemployees      Employee     @relation("approval_decisions_approverEmployeeIdToemployees", fields: [approverEmployeeId], references: [id], onUpdate: NoAction)
  employees_approval_decisions_delegatedFromEmployeeIdToemployees Employee?    @relation("approval_decisions_delegatedFromEmployeeIdToemployees", fields: [delegatedFromEmployeeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  step                                                            ApprovalStep @relation(fields: [stepId], references: [id], onUpdate: NoAction)

  @@map("approval_decisions")
}

model AuditLog {
  id                                           String   @id @db.Uuid
  actorUserId                                  String?  @db.Uuid
  effectiveActorUserId                         String?  @db.Uuid
  action                                       String   @db.VarChar(100)
  entityType                                   String   @db.VarChar(80)
  entityId                                     String?  @db.Uuid
  branchId                                     String?  @db.Uuid
  requestId                                    String?  @db.Uuid
  correlationId                                String?  @db.Uuid
  reason                                       String?
  beforeSnapshot                               Json?
  afterSnapshot                                Json?
  occurredAt                                   DateTime @default(now()) @db.Timestamptz(6)
  users_audit_logs_actorUserIdTousers          User?    @relation("audit_logs_actorUserIdTousers", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  branches                                     Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  users_audit_logs_effectiveActorUserIdTousers User?    @relation("audit_logs_effectiveActorUserIdTousers", fields: [effectiveActorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([entityType, entityId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_logs")
}

model Document {
  id           String            @id @db.Uuid
  companyId    String            @db.Uuid
  displayName  String            @db.VarChar(240)
  categoryCode String            @db.VarChar(50)
  accessClass  String            @db.VarChar(30)
  status       String            @db.VarChar(30)
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  links        DocumentLink[]
  versions     DocumentVersion[]
  company      Company           @relation(fields: [companyId], references: [id], onUpdate: NoAction)

  @@index([companyId, createdAt(sort: Desc), id(sort: Desc)], map: "documents_company_created_id_idx")
  @@map("documents")
}

model DocumentVersion {
  id               String    @id @db.Uuid
  documentId       String    @db.Uuid
  sequence         Int
  storageKey       String    @unique @db.VarChar(512)
  checksum         String    @db.VarChar(128)
  mimeType         String    @db.VarChar(160)
  sizeBytes        BigInt
  uploadedByUserId String    @db.Uuid
  effectiveFrom    DateTime? @db.Date
  expiresOn        DateTime? @db.Date
  signedAt         DateTime? @db.Timestamptz(6)
  document         Document  @relation(fields: [documentId], references: [id], onUpdate: NoAction)
  users            User      @relation(fields: [uploadedByUserId], references: [id], onUpdate: NoAction)

  @@unique([documentId, sequence], map: "uq_document_version_sequence")
  @@map("document_versions")
}

model DocumentLink {
  id         String   @id @db.Uuid
  documentId String   @db.Uuid
  entityType String   @db.VarChar(60)
  entityId   String   @db.Uuid
  purpose    String   @db.VarChar(50)
  document   Document @relation(fields: [documentId], references: [id], onUpdate: NoAction)

  @@unique([documentId, entityType, entityId, purpose], map: "uq_document_link")
  @@map("document_links")
}

