  createdAt           DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(6)
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  branch              Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  property            Property         @relation(fields: [propertyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  rentableSpace       RentableSpace?   @relation(fields: [rentableSpaceId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  tenant              Party?           @relation("InspectionTenant", fields: [tenantPartyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  inspector           Employee?        @relation("InspectionInspector", fields: [inspectorEmployeeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
