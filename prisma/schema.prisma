model ConstructionProject {
  id                      String                     @id @db.Uuid
  companyId               String                     @db.Uuid
  branchId                String                     @db.Uuid
  projectNumber           String                     @db.VarChar(50)
  name                    String                     @db.VarChar(200)
  economicModel           ConstructionEconomicModel
  status                  ConstructionProjectStatus  @default(DRAFT)
  clientPartyId           String?                    @db.Uuid
  propertyId              String?                    @db.Uuid
  leadId                  String?                    @db.Uuid
  developmentProjectId    String?                    @unique @db.Uuid
  projectManagerEmployeeId String?                   @db.Uuid
  startDate               DateTime?                  @db.Date
  expectedEndDate         DateTime?                  @db.Date
  actualCompletionDate    DateTime?                  @db.Date
  scope                   String?                    @db.VarChar(4000)
  notes                   String?                    @db.VarChar(2000)
  contractValue           Decimal?                   @db.Decimal(20, 4)
  currency                String                     @db.Char(3)
  plannedPercent          Decimal                    @default(0) @db.Decimal(5, 2)
  actualPercent           Decimal                    @default(0) @db.Decimal(5, 2)
  createdAt               DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                   @updatedAt @db.Timestamptz(6)
  company                 Company                    @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  branch                  Branch                     @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  client                  Party?                     @relation("ConstructionProjectClient", fields: [clientPartyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  property                Property?                  @relation(fields: [propertyId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lead                    Lead?                      @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  developmentProject      DevelopmentProject?        @relation(fields: [developmentProjectId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  projectManager          Employee?                  @relation("ConstructionProjectManager", fields: [projectManagerEmployeeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  contracts               ConstructionContract[]
  budgetLines             ConstructionBudgetLine[]
  milestones              ConstructionMilestone[]
  workPackages            ConstructionWorkPackage[]
  costs                   ConstructionCost[]
  billingEvents           ConstructionBillingEvent[]
  progressEntries         ConstructionProgressEntry[]

  @@unique([companyId, projectNumber], map: "uq_construction_project_company_number")
  @@index([companyId, branchId, status], map: "construction_project_register_idx")
  @@index([clientPartyId, status], map: "construction_project_client_idx")
  @@map("construction_projects")
}

model ConstructionContract {
