{
  "name": "real-estate-rental-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "\u003e=22.17.0 \u003c23",
    "pnpm": "\u003e=11.0.0 \u003c12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @rerms/api --filter @rerms/web dev",
    "dev:web": "pnpm --filter @rerms/web dev",
    "dev:api": "pnpm --filter @rerms/api dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint eslint.config.mjs \u0026\u0026 pnpm -r --if-present lint",
    "format": "prettier --write apps/api apps/web packages scripts docker .github docs/phases/phase-02-foundation docs/phases/phase-03-identity-access docs/security docs/architecture/technology-versions.md package.json pnpm-workspace.yaml tsconfig.base.json eslint.config.mjs .prettierrc.json \"docs/**/*.md\"",
    "format:check": "prettier --check apps/api apps/web packages scripts docker .github docs/phases/phase-02-foundation docs/phases/phase-03-identity-access docs/security docs/architecture/technology-versions.md package.json pnpm-workspace.yaml tsconfig.base.json eslint.config.mjs .prettierrc.json \"docs/**/*.md\"",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @rerms/shared build \u0026\u0026 pnpm -r --if-present test",
    "test:unit": "pnpm --filter @rerms/shared build \u0026\u0026 pnpm -r --if-present test:unit",
    "test:integration": "pnpm --filter @rerms/shared build \u0026\u0026 pnpm -r --if-present test:integration",
    "test:e2e": "pnpm --filter @rerms/shared build \u0026\u0026 pnpm -r --if-present test:e2e",
    "prisma:format": "pnpm --filter @rerms/database prisma:format",
    "prisma:validate": "pnpm --filter @rerms/database prisma:validate",
    "prisma:generate": "pnpm --filter @rerms/database prisma:generate",
    "infra:up": "docker compose -f docker/docker-compose.dev.yml up -d --wait",
    "infra:down": "docker compose -f docker/docker-compose.dev.yml down",
    "db:migrate:deploy": "pnpm --filter @rerms/database db:migrate:deploy",
    "db:seed": "pnpm --filter @rerms/database db:seed",
    "verify:governance": "node scripts/verify-governance.mjs",
    "security:rotate-party-key": "pnpm --filter @rerms/api exec tsx ../../scripts/rotate-party-contact-key.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@prisma/client": "6.19.3",
    "@types/node": "24.10.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  }
}
