// REVIEW-ONLY PROPOSED SCHEMA. Not the production prisma/schema.prisma.
// UUIDv7-compatible IDs are generated by the application/runtime and stored as uuid.
generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum PartyKind { PERSON ORGANIZATION }
enum BranchAccessMode { BRANCH MULTI_BRANCH COMPANY_WIDE }
enum ServiceModel { BROKERAGE TENANT_PLACEMENT FULL_MANAGEMENT MASTER_LEASE_SUBLEASE RENT_COLLECTION_ONLY COMPANY_OWNED }
enum EngagementStatus { DRAFT REVIEW APPROVED ACTIVE SUSPENDED TERMINATING ENDED REJECTED CANCELLED }
enum LeaseKind { STANDARD SUBLEASE COMPANY_OWNED COLLECTION_ONLY }
enum LeaseStatus { DRAFT REVIEW APPROVED SIGNING SIGNED PENDING_POSSESSION ACTIVE NOTICE HOLDOVER ENDED CANCELLED }
enum ReservationStatus { PENDING ACTIVE CONVERTED EXPIRED CANCELLED RELEASED }
enum PaymentStatus { CAPTURED VERIFYING VERIFIED POSTED PARTIALLY_ALLOCATED FULLY_ALLOCATED REJECTED REVERSED }
enum JournalStatus { DRAFT POSTED REVERSED }
enum PeriodStatus { OPEN SOFT_CLOSED CLOSED LOCKED }
enum FundClass { COMPANY_FUNDS OWNER_FUNDS SECURITY_DEPOSIT_FUNDS TENANT_CREDIT_FUNDS }
enum DepositTxnType { RECEIPT ADJUSTMENT DEDUCTION TRANSFER REFUND REVERSAL }
enum ApprovalStatus { REQUESTED PENDING APPROVED REJECTED EXPIRED WITHDRAWN }
enum PayoutStatus { DRAFT REVIEW APPROVED QUEUED PROCESSING PAID RECONCILED HELD REJECTED FAILED CANCELLED }
enum UtilityAllocationMethod { EQUAL AREA_BASED METERED OCCUPANCY_BASED FIXED_AMOUNT CUSTOM_PERCENTAGE }

model Company {
  id String @id @db.Uuid
  code String @unique @db.VarChar(32)
  name String @db.VarChar(200)
  defaultCurrency String @db.Char(3)
  timezone String @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  branches Branch[]
  parties Party[]
  @@map("companies")
}

model Branch {
  id String @id @db.Uuid
  companyId String @db.Uuid
  code String @db.VarChar(32)
  name String @db.VarChar(160)
  active Boolean @default(true)
  company Company @relation(fields:[companyId], references:[id])
  assignments EmployeeBranchAssignment[]
  @@unique([companyId, code], map:"uq_branches__company_code")
  @@map("branches")
}

model Department { id String @id @db.Uuid companyId String @db.Uuid code String @db.VarChar(32) name String @db.VarChar(120) active Boolean @default(true) @@unique([companyId,code]) @@map("departments") }
model User { id String @id @db.Uuid emailNormalized String @unique @db.VarChar(320) passwordHash String? @db.VarChar(255) active Boolean @default(true) createdAt DateTime @default(now()) @db.Timestamptz(6) employee Employee? @@map("users") }
model Employee { id String @id @db.Uuid companyId String @db.Uuid userId String @unique @db.Uuid partyId String @unique @db.Uuid employeeNumber String @db.VarChar(40) accessMode BranchAccessMode user User @relation(fields:[userId],references:[id]) branchAssignments EmployeeBranchAssignment[] roles EmployeeRole[] @@unique([companyId,employeeNumber]) @@map("employees") }
model EmployeeBranchAssignment { id String @id @db.Uuid employeeId String @db.Uuid branchId String @db.Uuid effectiveFrom DateTime @db.Date effectiveTo DateTime? @db.Date employee Employee @relation(fields:[employeeId],references:[id]) branch Branch @relation(fields:[branchId],references:[id]) @@index([employeeId,effectiveFrom]) @@map("employee_branch_assignments") }
model Role { id String @id @db.Uuid companyId String @db.Uuid code String @db.VarChar(64) name String @db.VarChar(120) active Boolean @default(true) permissions RolePermission[] employees EmployeeRole[] @@unique([companyId,code]) @@map("roles") }
model Permission { id String @id @db.Uuid code String @unique @db.VarChar(100) description String @db.VarChar(255) roles RolePermission[] @@map("permissions") }
model RolePermission { roleId String @db.Uuid permissionId String @db.Uuid role Role @relation(fields:[roleId],references:[id]) permission Permission @relation(fields:[permissionId],references:[id]) @@id([roleId,permissionId]) @@map("role_permissions") }
model EmployeeRole { id String @id @db.Uuid employeeId String @db.Uuid roleId String @db.Uuid branchId String? @db.Uuid effectiveFrom DateTime @db.Date effectiveTo DateTime? @db.Date employee Employee @relation(fields:[employeeId],references:[id]) role Role @relation(fields:[roleId],references:[id]) @@index([employeeId,effectiveFrom]) @@map("employee_roles") }

model Party {
  id String @id @db.Uuid
  companyId String @db.Uuid
  partyNumber String @db.VarChar(40)
  kind PartyKind
  displayName String @db.VarChar(240)
  active Boolean @default(true)
  company Company @relation(fields:[companyId],references:[id])
  person PersonProfile?
  organization OrganizationProfile?
  owner OwnerProfile?
  tenant TenantProfile?
  applicant ApplicantProfile?
  vendor VendorProfile?
  guarantor GuarantorProfile?
  contacts ContactPoint[]
  addresses Address[]
  @@unique([companyId,partyNumber])
  @@index([companyId,displayName])
  @@map("parties")
}
model PersonProfile { partyId String @id @db.Uuid givenName String @db.VarChar(120) familyName String @db.VarChar(120) birthDate DateTime? @db.Date party Party @relation(fields:[partyId],references:[id]) @@map("person_profiles") }
model OrganizationProfile { partyId String @id @db.Uuid legalName String @db.VarChar(240) registrationNumber String? @db.VarChar(100) party Party @relation(fields:[partyId],references:[id]) @@map("organization_profiles") }
model OwnerProfile { partyId String @id @db.Uuid verifiedAt DateTime? @db.Timestamptz(6) party Party @relation(fields:[partyId],references:[id]) @@map("owner_profiles") }
model TenantProfile { partyId String @id @db.Uuid party Party @relation(fields:[partyId],references:[id]) @@map("tenant_profiles") }
model ApplicantProfile { partyId String @id @db.Uuid party Party @relation(fields:[partyId],references:[id]) @@map("applicant_profiles") }
model VendorProfile { partyId String @id @db.Uuid vendorCode String @unique @db.VarChar(40) approvedAt DateTime? @db.Timestamptz(6) party Party @relation(fields:[partyId],references:[id]) services VendorService[] @@map("vendor_profiles") }
model GuarantorProfile { partyId String @id @db.Uuid party Party @relation(fields:[partyId],references:[id]) @@map("guarantor_profiles") }
model ContactPoint { id String @id @db.Uuid partyId String @db.Uuid type String @db.VarChar(30) valueEncrypted String @db.Text normalizedHash String? @db.VarChar(128) primary Boolean @default(false) party Party @relation(fields:[partyId],references:[id]) @@index([normalizedHash]) @@map("contact_points") }
model Address { id String @id @db.Uuid partyId String @db.Uuid type String @db.VarChar(30) line1 String @db.VarChar(200) city String? @db.VarChar(100) countryCode String @db.Char(2) party Party @relation(fields:[partyId],references:[id]) @@map("addresses") }
model PartyRelationship { id String @id @db.Uuid sourcePartyId String @db.Uuid targetPartyId String @db.Uuid type String @db.VarChar(50) effectiveFrom DateTime @db.Date effectiveTo DateTime? @db.Date @@index([sourcePartyId,type]) @@map("party_relationships") }

model Property { id String @id @db.Uuid companyId String @db.Uuid propertyCode String @db.VarChar(40) name String @db.VarChar(200) propertyType String @db.VarChar(50) status String @db.VarChar(30) buildings Building[] spaces RentableSpace[] branchHistory PropertyBranchAssignment[] ownerships PropertyOwnership[] engagements ServiceEngagement[] @@unique([companyId,propertyCode]) @@map("properties") }
model Building { id String @id @db.Uuid propertyId String @db.Uuid buildingCode String @db.VarChar(40) name String @db.VarChar(160) active Boolean @default(true) property Property @relation(fields:[propertyId],references:[id]) @@unique([propertyId,buildingCode]) @@map("buildings") }
model PropertyBranchAssignment { id String @id @db.Uuid propertyId String @db.Uuid branchId String @db.Uuid effectiveFrom DateTime @db.Date effectiveTo DateTime? @db.Date property Property @relation(fields:[propertyId],references:[id]) @@index([branchId,effectiveFrom]) @@map("property_branch_assignments") }
model PropertyOwnership { id String @id @db.Uuid propertyId String @db.Uuid ownerPartyId String @db.Uuid ownershipPercent Decimal @db.Decimal(9,6) effectiveFrom DateTime @db.Date effectiveTo DateTime? @db.Date property Property @relation(fields:[propertyId],references:[id]) entitlements PropertyOwnerEntitlement[] @@index([propertyId,effectiveFrom]) @@map("property_ownerships") }
model PropertyOwnerEntitlement { id String @id @db.Uuid ownershipId String @db.Uuid payoutPercent Decimal @db.Decimal(9,6) effectiveFrom DateTime @db.Date effectiveTo DateTime? @db.Date ownership PropertyOwnership @relation(fields:[ownershipId],references:[id]) @@index([ownershipId,effectiveFrom]) @@map("property_owner_entitlements") }
model RentableSpaceType { id String @id @db.Uuid code String @unique @db.VarChar(50) name String @db.VarChar(100) active Boolean @default(true) spaces RentableSpace[] @@map("rentable_space_types") }
model RentableSpace { id String @id @db.Uuid propertyId String @db.Uuid buildingId String? @db.Uuid typeId String @db.Uuid spaceCode String @db.VarChar(50) status String @db.VarChar(30) property Property @relation(fields:[propertyId],references:[id]) type RentableSpaceType @relation(fields:[typeId],references:[id]) versions RentableSpaceVersion[] childRelations RentableSpaceParentHistory[] @relation("ChildSpace") parentRelations RentableSpaceParentHistory[] @relation("ParentSpace") @@unique([propertyId,spaceCode]) @@index([propertyId,status,typeId]) @@map("rentable_spaces") }
model RentableSpaceVersion { id String @id @db.Uuid rentableSpaceId String @db.Uuid versionNo Int effectiveFrom DateTime @db.Date effectiveTo DateTime? @db.Date usableArea Decimal? @db.Decimal(20,6) areaUnit String? @db.VarChar(20) pricingMethod String? @db.VarChar(30) rate Decimal? @db.Decimal(20,4) currency String? @db.Char(3) attributes Json? space RentableSpace @relation(fields:[rentableSpaceId],references:[id]) @@unique([rentableSpaceId,versionNo]) @@index([rentableSpaceId,effectiveFrom]) @@map("rentable_space_versions") }
model RentableSpaceParentHistory { id String @id @db.Uuid childSpaceId String @db.Uuid parentSpaceId String @db.Uuid effectiveFrom DateTime @db.Date effectiveTo DateTime? @db.Date child RentableSpace @relation("ChildSpace",fields:[childSpaceId],references:[id]) parent RentableSpace @relation("ParentSpace",fields:[parentSpaceId],references:[id]) @@index([childSpaceId,effectiveFrom]) @@index([parentSpaceId,effectiveFrom]) @@map("rentable_space_parent_history") }
model SpaceSuccessor { predecessorSpaceId String @db.Uuid successorSpaceId String @db.Uuid relationType String @db.VarChar(20) effectiveDate DateTime @db.Date @@id([predecessorSpaceId,successorSpaceId]) @@map("space_successors") }

model ServiceEngagement { id String @id @db.Uuid propertyId String @db.Uuid rentableSpaceId String? @db.Uuid inheritedFromId String? @db.Uuid model ServiceModel status EngagementStatus effectiveFrom DateTime @db.Date effectiveTo DateTime? @db.Date overrideMode String? @db.VarChar(30) agreementDocumentVersionId String? @db.Uuid property Property @relation(fields:[propertyId],references:[id]) parent ServiceEngagement? @relation("EngagementInheritance",fields:[inheritedFromId],references:[id]) children ServiceEngagement[] @relation("EngagementInheritance") parties ServiceEngagementParty[] @@index([propertyId,status,effectiveFrom]) @@index([rentableSpaceId,status,effectiveFrom]) @@map("service_engagements") }
model ServiceEngagementParty { engagementId String @db.Uuid partyId String @db.Uuid role String @db.VarChar(40) engagement ServiceEngagement @relation(fields:[engagementId],references:[id]) @@id([engagementId,partyId,role]) @@map("service_engagement_parties") }

model Lead { id String @id @db.Uuid companyId String @db.Uuid leadNumber String @db.VarChar(40) partyId String? @db.Uuid sourceCode String @db.VarChar(50) status String @db.VarChar(30) assignedEmployeeId String? @db.Uuid createdAt DateTime @default(now()) @db.Timestamptz(6) preferences LeadPreference[] activities LeadActivity[] assignments LeadAssignment[] @@unique([companyId,leadNumber]) @@index([assignedEmployeeId,status]) @@map("leads") }
model LeadPreference { id String @id @db.Uuid leadId String @db.Uuid key String @db.VarChar(50) value Json lead Lead @relation(fields:[leadId],references:[id]) @@map("lead_preferences") }
model LeadActivity { id String @id @db.Uuid leadId String @db.Uuid type String @db.VarChar(30) occurredAt DateTime @db.Timestamptz(6) notes String? @db.Text lead Lead @relation(fields:[leadId],references:[id]) @@index([leadId,occurredAt]) @@map("lead_activities") }
model LeadAssignment { id String @id @db.Uuid leadId String @db.Uuid employeeId String @db.Uuid assignedFrom DateTime @db.Timestamptz(6) assignedTo DateTime? @db.Timestamptz(6) lead Lead @relation(fields:[leadId],references:[id]) @@index([employeeId,assignedTo]) @@map("lead_assignments") }
model Inquiry { id String @id @db.Uuid leadId String @db.Uuid rentableSpaceId String? @db.Uuid channel String @db.VarChar(30) occurredAt DateTime @db.Timestamptz(6) @@map("inquiries") }
model Listing { id String @id @db.Uuid rentableSpaceId String @db.Uuid listingNumber String @unique @db.VarChar(40) status String @db.VarChar(30) publishedAt DateTime? @db.Timestamptz(6) @@index([rentableSpaceId,status]) @@map("listings") }
model Viewing { id String @id @db.Uuid leadId String @db.Uuid rentableSpaceId String @db.Uuid assignedEmployeeId String @db.Uuid status String @db.VarChar(30) scheduledAt DateTime @db.Timestamptz(6) @@index([rentableSpaceId,scheduledAt]) @@map("viewings") }
model Application { id String @id @db.Uuid leadId String? @db.Uuid rentableSpaceId String @db.Uuid applicationNumber String @unique @db.VarChar(40) status String @db.VarChar(30) submittedAt DateTime? @db.Timestamptz(6) parties ApplicationParty[] checks ScreeningCheck[] @@index([rentableSpaceId,status]) @@map("applications") }
model ApplicationParty { applicationId String @db.Uuid partyId String @db.Uuid role String @db.VarChar(30) application Application @relation(fields:[applicationId],references:[id]) @@id([applicationId,partyId,role]) @@map("application_parties") }
model ScreeningCheck { id String @id @db.Uuid applicationId String @db.Uuid type String @db.VarChar(50) status String @db.VarChar(30) resultCode String? @db.VarChar(50) evidenceDocumentVersionId String? @db.Uuid application Application @relation(fields:[applicationId],references:[id]) @@map("screening_checks") }
model Reservation { id String @id @db.Uuid applicationId String? @db.Uuid rentableSpaceId String @db.Uuid status ReservationStatus startsAt DateTime @db.Timestamptz(6) expiresAt DateTime @db.Timestamptz(6) convertedLeaseId String? @unique @db.Uuid @@index([rentableSpaceId,status,expiresAt]) @@map("reservations") }

model Lease { id String @id @db.Uuid rentableSpaceId String @db.Uuid serviceEngagementId String @db.Uuid masterLeaseId String? @db.Uuid leaseNumber String @unique @db.VarChar(50) kind LeaseKind status LeaseStatus agreementDate DateTime? @db.Date leaseStartDate DateTime @db.Date possessionDate DateTime? @db.Date leaseEndDate DateTime @db.Date currency String @db.Char(3) version Int @default(1) parties LeaseParty[] versions LeaseVersion[] possessions LeasePossession[] schedules RecurringChargeSchedule[] @@index([rentableSpaceId,status,leaseEndDate]) @@map("leases") }
model LeaseParty { id String @id @db.Uuid leaseId String @db.Uuid partyId String @db.Uuid role String @db.VarChar(30) effectiveFrom DateTime @db.Date effectiveTo DateTime? @db.Date lease Lease @relation(fields:[leaseId],references:[id]) @@index([partyId,role]) @@map("lease_parties") }
model LeaseVersion { id String @id @db.Uuid leaseId String @db.Uuid sequence Int rentableSpaceVersionId String @db.Uuid documentVersionId String? @db.Uuid effectiveFrom DateTime @db.Date effectiveTo DateTime? @db.Date signedAt DateTime? @db.Timestamptz(6) contentHash String? @db.VarChar(128) termsSnapshot Json lease Lease @relation(fields:[leaseId],references:[id]) @@unique([leaseId,sequence]) @@map("lease_versions") }
model LeasePossession { id String @id @db.Uuid leaseId String @db.Uuid rentableSpaceId String @db.Uuid possessionFrom DateTime @db.Timestamptz(6) possessionTo DateTime? @db.Timestamptz(6) status String @db.VarChar(20) lease Lease @relation(fields:[leaseId],references:[id]) @@index([rentableSpaceId,possessionFrom]) @@map("lease_possessions") }
model LeaseAmendment { id String @id @db.Uuid leaseId String @db.Uuid fromVersionId String @db.Uuid toVersionId String @db.Uuid effectiveDate DateTime @db.Date reason String @db.Text @@map("lease_amendments") }
model LeaseRenewal { id String @id @db.Uuid leaseId String @db.Uuid successorLeaseId String @unique @db.Uuid effectiveDate DateTime @db.Date @@map("lease_renewals") }
model LeaseTermination { id String @id @db.Uuid leaseId String @db.Uuid effectiveDate DateTime @db.Date reasonCode String @db.VarChar(50) noticeDocumentVersionId String? @db.Uuid @@map("lease_terminations") }
model MoveIn { id String @id @db.Uuid leaseId String @unique @db.Uuid completedAt DateTime @db.Timestamptz(6) inspectionId String? @db.Uuid @@map("move_ins") }
model MoveOut { id String @id @db.Uuid leaseId String @unique @db.Uuid completedAt DateTime @db.Timestamptz(6) inspectionId String? @db.Uuid @@map("move_outs") }
model KeyAssignment { id String @id @db.Uuid leaseId String @db.Uuid keyCode String @db.VarChar(60) assignedAt DateTime @db.Timestamptz(6) returnedAt DateTime? @db.Timestamptz(6) @@map("key_assignments") }
model RecurringChargeSchedule { id String @id @db.Uuid leaseId String @db.Uuid chargeTypeId String @db.Uuid amount Decimal @db.Decimal(20,4) currency String @db.Char(3) frequency String @db.VarChar(20) effectiveFrom DateTime @db.Date effectiveTo DateTime? @db.Date lease Lease @relation(fields:[leaseId],references:[id]) @@index([leaseId,effectiveFrom]) @@map("recurring_charge_schedules") }
